    instruction: "Add interactive feature navigation bar in SleepDashboard"
    replacement_infos {
      original_chunk {
        target_content: "        </div>\n      </div>\n\n      {/* 2. Top Hero Banner: Restorative Sleep Score + Deep Sleep Reservoir */}"
        replacement_content: "        </div>\n      </div>\n\n      {/* Quick Interactive Studio Shortcuts */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n        <button\n          onClick={onNavigateToScience}\n          className=\"p-4 rounded-2xl bg-gradient-to-r from-[#0F172A] to-[#1E293B]/60 border border-[#2DD4BF44] hover:border-[#2DD4BF] text-left transition flex items-center justify-between group cursor-pointer shadow-lg\"\n        >\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#2DD4BF15] border border-[#2DD4BF33] flex items-center justify-center text-[#2DD4BF]\">\n              <Microscope className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-white group-hover:text-[#2DD4BF] transition\">Science & Mechanisms</div>\n              <div className=\"text-[11px] text-[#94A3B8]\">Glymphatic, Vagal & SCN Models</div>\n            </div>\n          </div>\n          <ChevronRight className=\"w-4 h-4 text-[#64748B] group-hover:text-[#2DD4BF] group-hover:translate-x-0.5 transition\" />\n        </button>\n\n        <button\n          onClick={onNavigateToNeuromodulation}\n          className=\"p-4 rounded-2xl bg-gradient-to-r from-[#0F172A] to-[#1E293B]/60 border border-[#818CF844] hover:border-[#818CF8] text-left transition flex items-center justify-between group cursor-pointer shadow-lg\"\n        >\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#818CF815] border border-[#818CF833] flex items-center justify-center text-[#818CF8]\">\n              <Zap className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-white group-hover:text-[#818CF8] transition\">Acoustic Synthesizer</div>\n              <div className=\"text-[11px] text-[#94A3B8]\">2.5Hz Delta Beats & 4-7-8 Breath</div>\n            </div>\n          </div>\n          <ChevronRight className=\"w-4 h-4 text-[#64748B] group-hover:text-[#818CF8] group-hover:translate-x-0.5 transition\" />\n        </button>\n\n        <button\n          onClick={onNavigateToLongevity}\n          className=\"p-4 rounded-2xl bg-gradient-to-r from-[#0F172A] to-[#1E293B]/60 border border-[#C084FC44] hover:border-[#C084FC] text-left transition flex items-center justify-between group cursor-pointer shadow-lg\"\n        >\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#C084FC15] border border-[#C084FC33] flex items-center justify-center text-[#C084FC]\">\n              <ShieldCheck className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-white group-hover:text-[#C084FC] transition\">Health & Longevity</div>\n              <div className=\"text-[11px] text-[#94A3B8]\">Bio-Age & 10-Yr Prognosis</div>\n            </div>\n          </div>\n          <ChevronRight className=\"w-4 h-4 text-[#64748B] group-hover:text-[#C084FC] group-hover:translate-x-0.5 transition\" />\n        </button>\n      </div>\n\n      {/* 2. Top Hero Banner: Restorative Sleep Score + Deep Sleep Reservoir */}"
      }
