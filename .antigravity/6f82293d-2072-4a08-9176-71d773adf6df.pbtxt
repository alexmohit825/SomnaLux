    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export interface SwiftFileTemplate {\n  id: string;\n  filename: string;\n  category: \'HealthKit & Core\' | \'SwiftUI Views\' | \'CBT-I Logic\' | \'Audio & Widgets\';\n  description: string;\n  code: string;\n}\n\nexport const swiftCodeTemplates: SwiftFileTemplate[] = [\n  {\n    id: \'healthkit-manager\',\n    filename: \'HealthKitSleepManager.swift\',\n    category: \'HealthKit & Core\',\n    description: \'Queries Apple HealthKit for Sleep Stages (Deep, REM, Core, Awake), HRV (SDNN), and Resting HR with background delivery.\',\n    code: `//\n//  HealthKitSleepManager.swift\n//  SomnaLux - Ultimate Sleep & Longevity\n//  Created for iOS 17+ / Swift 5.9\n//\n\nimport Foundation\nimport HealthKit\nimport Combine\n\n@MainActor\npublic final class HealthKitSleepManager: ObservableObject {\n    public static let shared = HealthKitSleepManager()\n    \n    private let healthStore = HKHealthStore()\n    \n    @Published public var isAuthorized: Bool = false\n    @Published public var latestSession: NativeSleepSession?\n    @Published public var recentHrvAverage: Double = 0.0\n    @Published public var restingHeartRate: Double = 0.0\n    @Published public var isQuerying: Bool = false\n    @Published public var authorizationError: String?\n\n    private init() {}\n    \n    /// Request HealthKit Permissions for Sleep Analysis, HRV, and Resting HR\n    public func requestAuthorization() async {\n        guard HKHealthStore.isHealthDataAvailable() else {\n            authorizationError = \"HealthKit is not supported on this device.\"\n            return\n        }\n        \n        guard let sleepType = HKObjectType.categoryType(forIdentifier: .sleepAnalysis),\n              let hrvType = HKObjectType.quantityType(forIdentifier: .heartRateVariabilitySDNN),\n              let rhrType = HKObjectType.quantityType(forIdentifier: .restingHeartRate),\n              let respType = HKObjectType.quantityType(forIdentifier: .respiratoryRate) else {\n            return\n        }\n        \n        let readTypes: Set<HKObjectType> = [sleepType, hrvType, rhrType, respType]\n        \n        do {\n            try await healthStore.requestAuthorization(toShare: [], read: readTypes)\n            self.isAuthorized = true\n            await fetchLastNightSleepData()\n        } catch {\n            self.authorizationError = error.localizedDescription\n        }\n    }\n    \n    /// Fetch and process full sleep architecture stages for the most recent night\n    public func fetchLastNightSleepData() async {\n        guard let sleepType = HKCategoryType.categoryType(forIdentifier: .sleepAnalysis) else { return }\n        \n        isQuerying = true\n        defer { isQuerying = false }\n        \n        let calendar = Calendar.current\n        let now = Date()\n        guard let startDate = calendar.date(byAdding: .hour, value: -24, to: now) else { return }\n        \n        let predicate = HKQuery.predicateForSamples(withStart: startDate, end: now, options: .strictStartDate)\n        let sortDescriptor = NSSortDescriptor(key: HKSampleSortIdentifierEndDate, ascending: false)\n        \n        return await withCheckedContinuation { continuation in\n            let query = HKSampleQuery(\n                sampleType: sleepType,\n                predicate: predicate,\n                limit: HKObjectQueryNoLimit,\n                sortDescriptors: [sortDescriptor]\n            ) { [weak self] _, samples, error in\n                guard let self = self, let samples = samples as? [HKCategorySample], error == nil else {\n                    continuation.resume()\n                    return\n                }\n                \n                Task { @MainActor in\n                    self.processSleepSamples(samples)\n                    await self.fetchRecentBiomarkers(startDate: startDate, endDate: now)\n                    continuation.resume()\n                }\n            }\n            healthStore.execute(query)\n        }\n    }\n    \n    private func processSleepSamples(_ samples: [HKCategorySample]) {\n        var deepMinutes: Double = 0\n        var remMinutes: Double = 0\n        var coreMinutes: Double = 0\n        var awakeMinutes: Double = 0\n        var inBedStart: Date?\n        var inBedEnd: Date?\n        \n        for sample in samples {\n            let duration = sample.endDate.timeIntervalSince(sample.startDate) / 60.0\n            \n            if inBedStart == nil || sample.startDate < inBedStart! { inBedStart = sample.startDate }\n            if inBedEnd == nil || sample.endDate > inBedEnd! { inBedEnd = sample.endDate }\n            \n            switch sample.value {\n            case HKCategoryValueSleepAnalysis.asleepDeep.rawValue:\n                deepMinutes += duration\n            case HKCategoryValueSleepAnalysis.asleepREM.rawValue:\n                remMinutes += duration\n            case HKCategoryValueSleepAnalysis.asleepCore.rawValue:\n                coreMinutes += duration\n            case HKCategoryValueSleepAnalysis.awake.rawValue:\n                awakeMinutes += duration\n            default:\n                break\n            }\n        }\n        \n        let totalSleepMinutes = deepMinutes + remMinutes + coreMinutes\n        let inBedMinutes = (inBedEnd?.timeIntervalSince(inBedStart ?? Date()) ?? 0) / 60.0\n        let efficiency = inBedMinutes > 0 ? (totalSleepMinutes / inBedMinutes) * 100.0 : 0.0\n        \n        self.latestSession = NativeSleepSession(\n            startDate: inBedStart ?? Date(),\n            endDate: inBedEnd ?? Date(),\n            totalSleepMinutes: totalSleepMinutes,\n            inBedMinutes: inBedMinutes,\n            deepMinutes: deepMinutes,\n            remMinutes: remMinutes,\n            lightMinutes: coreMinutes,\n            awakeMinutes: awakeMinutes,\n            efficiency: efficiency\n        )\n    }\n    \n    private func fetchRecentBiomarkers(startDate: Date, endDate: Date) async {\n        guard let hrvType = HKQuantityType.quantityType(forIdentifier: .heartRateVariabilitySDNN) else { return }\n        let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)\n        \n        return await withCheckedContinuation { continuation in\n            let query = HKStatisticsQuery(quantityType: hrvType, quantitySamplePredicate: predicate, options: .discreteAverage) { [weak self] _, stats, _ in\n                Task { @MainActor in\n                    if let avg = stats?.averageQuantity()?.doubleValue(for: HKUnit.secondUnit(with: .milli)) {\n                        self?.recentHrvAverage = avg\n                    }\n                    continuation.resume()\n                }\n            }\n            healthStore.execute(query)\n        }\n    }\n}\n\npublic struct NativeSleepSession: Identifiable, Sendable {\n    public var id: UUID = UUID()\n    public let startDate: Date\n    public let endDate: Date\n    public let totalSleepMinutes: Double\n    public let inBedMinutes: Double\n    public let deepMinutes: Double\n    public let remMinutes: Double\n    public let lightMinutes: Double\n    public let awakeMinutes: Double\n    public let efficiency: Double\n    \n    public var deepPercentage: Double {\n        totalSleepMinutes > 0 ? (deepMinutes / totalSleepMinutes) * 100.0 : 0\n    }\n    public var remPercentage: Double {\n        totalSleepMinutes > 0 ? (remMinutes / totalSleepMinutes) * 100.0 : 0\n    }\n}`\n  },\n  {\n    id: \'hypnogram-view\',\n    filename: \'HypnogramCanvasView.swift\',\n    category: \'SwiftUI Views\',\n    description: \'Custom GPU-accelerated SwiftUI Canvas rendering sleep architecture hypnogram with stage glow gradients.\',\n    code: `//\n//  HypnogramCanvasView.swift\n//  SomnaLux\n//  Custom SwiftUI Sleep Stage Architecture Visualizer\n//\n\nimport SwiftUI\n\npublic enum SleepStageType: String, CaseIterable, Sendable {\n    case awake = \"Awake\"\n    case rem = \"REM\"\n    case light = \"Light\"\n    case deep = \"Deep (SWS)\"\n    \n    public var levelIndex: CGFloat {\n        switch self {\n        case .awake: return 0\n        case .rem: return 1\n        case .light: return 2\n        case .deep: return 3\n        }\n    }\n    \n    public var color: Color {\n        switch self {\n        case .awake: return Color(red: 0.96, green: 0.62, blue: 0.23) // Amber\n        case .rem: return Color(red: 0.65, green: 0.55, blue: 0.98)   // Lavender\n        case .light: return Color(red: 0.38, green: 0.40, blue: 0.94) // Indigo\n        case .deep: return Color(red: 0.08, green: 0.72, blue: 0.65)  // Bioluminescent Teal\n        }\n    }\n}\n\npublic struct SleepEpochData: Identifiable {\n    public let id = UUID()\n    public let minuteOffset: Double\n    public let stage: SleepStageType\n    public let heartRate: Double\n}\n\npublic struct HypnogramCanvasView: View {\n    public let epochs: [SleepEpochData]\n    public let totalMinutes: Double\n    @State private var scrubLocation: CGFloat? = nil\n    \n    public init(epochs: [SleepEpochData], totalMinutes: Double = 480) {\n        self.epochs = epochs\n        self.totalMinutes = totalMinutes\n    }\n    \n    public var body: some View {\n        VStack(alignment: .leading, spacing: 12) {\n            // Stage Level Labels & Canvas\n            HStack(spacing: 8) {\n                VStack(alignment: .trailing, spacing: 0) {\n                    ForEach(SleepStageType.allCases, id: \\\\.self) { stage in\n                        Text(stage.rawValue)\n                            .font(.system(size: 10, weight: .semibold, design: .monospaced))\n                            .foregroundColor(stage.color)\n                            .frame(maxHeight: .infinity, alignment: .center)\n                    }\n                }\n                .frame(width: 70)\n                \n                Canvas { context, size in\n                    let stepHeight = size.height / 4.0\n                    \n                    // 1. Draw horizontal stage guide lines\n                    for i in 0..<4 {\n                        let y = CGFloat(i) * stepHeight + (stepHeight / 2.0)\n                        var path = Path()\n                        path.move(to: CGPoint(x: 0, y: y))\n                        path.addLine(to: CGPoint(x: size.width, y: y))\n                        context.stroke(path, with: .color(Color.white.opacity(0.08)), lineWidth: 1)\n                    }\n                    \n                    guard !epochs.isEmpty else { return }\n                    \n                    // 2. Draw Hypnogram stepped path\n                    var hypnoPath = Path()\n                    var areaPath = Path()\n                    \n                    let firstX = CGFloat(epochs[0].minuteOffset / totalMinutes) * size.width\n                    let firstY = epochs[0].stage.levelIndex * stepHeight + (stepHeight / 2.0)\n                    \n                    hypnoPath.move(to: CGPoint(x: firstX, y: firstY))\n                    areaPath.move(to: CGPoint(x: firstX, y: size.height))\n                    areaPath.addLine(to: CGPoint(x: firstX, y: firstY))\n                    \n                    for epoch in epochs {\n                        let x = CGFloat(epoch.minuteOffset / totalMinutes) * size.width\n                        let y = epoch.stage.levelIndex * stepHeight + (stepHeight / 2.0)\n                        \n                        // Stepped corner interpolation\n                        hypnoPath.addLine(to: CGPoint(x: x, y: hypnoPath.currentPoint?.y ?? y))\n                        hypnoPath.addLine(to: CGPoint(x: x, y: y))\n                        \n                        areaPath.addLine(to: CGPoint(x: x, y: areaPath.currentPoint?.y ?? y))\n                        areaPath.addLine(to: CGPoint(x: x, y: y))\n                    }\n                    \n                    if let lastX = epochs.last.map({ CGFloat($0.minuteOffset / totalMinutes) * size.width }) {\n                        areaPath.addLine(to: CGPoint(x: lastX, y: size.height))\n                        areaPath.closeSubpath()\n                    }\n                    \n                    // Fill subtle gradient under curve\n                    let gradient = Gradient(colors: [\n                        Color(red: 0.08, green: 0.72, blue: 0.65).opacity(0.25),\n                        Color(red: 0.38, green: 0.40, blue: 0.94).opacity(0.05),\n                        Color.clear\n                    ])\n                    context.fill(areaPath, with: .linearGradient(gradient, startPoint: .zero, endPoint: CGPoint(x: 0, y: size.height)))\n                    \n                    // Stroke vibrant hypnogram line\n                    context.stroke(hypnoPath, with: .color(Color(red: 0.08, green: 0.72, blue: 0.65)), lineWidth: 2.5)\n                }\n                .frame(height: 140)\n                .background(Color(red: 0.06, green: 0.08, blue: 0.13))\n                .cornerRadius(12)\n                .overlay(\n                    RoundedRectangle(cornerRadius: 12)\n                        .stroke(Color.white.opacity(0.1), lineWidth: 1)\n                )\n            }\n            \n            // Time Ruler\n            HStack {\n                Text(\"11:00 PM\").font(.caption2).foregroundColor(.secondary)\n                Spacer()\n                Text(\"2:00 AM\").font(.caption2).foregroundColor(.secondary)\n                Spacer()\n                Text(\"5:00 AM\").font(.caption2).foregroundColor(.secondary)\n                Spacer()\n                Text(\"7:00 AM\").font(.caption2).foregroundColor(.secondary)\n            }\n            .padding(.leading, 78)\n        }\n        .padding(16)\n        .background(Color(red: 0.04, green: 0.06, blue: 0.10))\n        .cornerRadius(16)\n    }\n}`\n  },\n  {\n    id: \'cbti-restriction-engine\',\n    filename: \'CBTISleepRestrictionEngine.swift\',\n    category: \'CBT-I Logic\',\n    description: \'Implements clinical Sleep Restriction Therapy (SRT) and Stimulus Control algorithms for insomnia recovery.\',\n    code: `//\n//  CBTISleepRestrictionEngine.swift\n//  SomnaLux\n//  Clinical CBT-I Protocol & Sleep Restriction Algorithms\n//\n\nimport Foundation\n\npublic struct CBTIScheduleRecommendation: Sendable {\n    public let prescribedTimeInBedHours: Double\n    public let targetBedtime: String\n    public let targetWakeTime: String\n    public let currentEfficiency: Double\n    public let phase: String\n    public let clinicalDirective: String\n    public let safetyNotice: String\n}\n\npublic struct CBTISleepRestrictionEngine {\n    \n    /// Calculates optimal Time in Bed (TIB) using the 5-day rolling sleep diary efficiency\n    /// Standard protocol: If Efficiency > 85%, expand TIB by 15-30m. If < 80%, restrict TIB by 15-30m (Floor = 5.0h).\n    public static func computePrescription(\n        averageTotalSleepTimeHours: Double,\n        averageTimeInBedHours: Double,\n        fixedWakeTime: Date = Calendar.current.date(bySettingHour: 6, minute: 30, second: 0, of: Date()) ?? Date(),\n        consecutiveDaysLogged: Int = 7\n    ) -> CBTIScheduleRecommendation {\n        \n        let efficiency = (averageTotalSleepTimeHours / max(1.0, averageTimeInBedHours)) * 100.0\n        var prescribedTIB: Double = averageTotalSleepTimeHours\n        var phase = \"Baseline Titration\"\n        var directive = \"\"\n        \n        // Safety Floor: Never restrict Time in Bed below 5.0 hours to prevent micro-sleep episodes\n        if efficiency < 80.0 {\n            phase = \"Sleep Restriction Phase\"\n            prescribedTIB = max(5.0, averageTotalSleepTimeHours)\n            directive = \"Consolidate sleep drive by restricting bed duration to match actual sleep time (\\(String(format: \"%.1f\", prescribedTIB)) hrs). Build homeostatic adenosine pressure.\"\n        } else if efficiency >= 85.0 && efficiency <= 90.0 {\n            phase = \"Controlled Expansion (+15 min)\"\n            prescribedTIB = min(averageTimeInBedHours + 0.25, 9.0)\n            directive = \"Excellent consolidation (>85% efficiency). Expanding nightly bed window by 15 minutes.\"\n        } else if efficiency > 90.0 {\n            phase = \"Rapid Expansion (+30 min)\"\n            prescribedTIB = min(averageTimeInBedHours + 0.5, 9.0)\n            directive = \"High sleep continuity (>90% efficiency). Expanding window by 30 minutes to capture more REM sleep.\"\n        } else {\n            phase = \"Maintenance & Stabilization\"\n            prescribedTIB = averageTimeInBedHours\n            directive = \"Maintain strict current wake-up anchor to synchronize circadian rhythm.\"\n        }\n        \n        // Calculate new prescribed bedtime from fixed wake time\n        let calendar = Calendar.current\n        let prescribedBedtimeDate = calendar.date(byAdding: .minute, value: -Int(prescribedTIB * 60), to: fixedWakeTime) ?? fixedWakeTime\n        \n        let formatter = DateFormatter()\n        formatter.timeStyle = .short\n        \n        return CBTIScheduleRecommendation(\n            prescribedTimeInBedHours: prescribedTIB,\n            targetBedtime: formatter.string(from: prescribedBedtimeDate),\n            targetWakeTime: formatter.string(from: fixedWakeTime),\n            currentEfficiency: efficiency,\n            phase: phase,\n            clinicalDirective: directive,\n            safetyNotice: \"Contraindicated in untreated bipolar disorder, seizure disorders, or hazardous machinery operators without clinician supervision.\"\n        )\n    }\n}`\n  },\n  {\n    id: \'audio-synthesizer-engine\',\n    filename: \'AudioSynthesizerEngine.swift\',\n    category: \'Audio & Widgets\',\n    description: \'AVAudioEngine in Swift producing Delta (0.5-4Hz) binaural beats and organic Brown Noise in real-time.\',\n    code: `//\n//  AudioSynthesizerEngine.swift\n//  SomnaLux\n//  Native AVAudioEngine Binaural Beat & Sleep Wave Synthesizer\n//\n\nimport Foundation\nimport AVFoundation\n\npublic final class AudioSynthesizerEngine: ObservableObject {\n    public static let shared = AudioSynthesizerEngine()\n    \n    private var audioEngine = AVAudioEngine()\n    private var sourceNode: AVAudioSourceNode?\n    \n    @Published public var isPlaying: Bool = false\n    @Published public var currentBeatFrequency: Double = 2.5 // 2.5 Hz Delta\n    @Published public var baseCarrierFrequency: Double = 196.0 // G3 note\n    @Published public var masterVolume: Float = 0.5\n    \n    private var sampleRate: Double = 44100.0\n    private var phaseLeft: Double = 0.0\n    private var phaseRight: Double = 0.0\n    \n    private init() {\n        setupAudioSession()\n    }\n    \n    private func setupAudioSession() {\n        do {\n            let session = AVAudioSession.sharedInstance()\n            try session.setCategory(.playback, mode: .default, options: [.mixWithOthers, .duckOthers])\n            try session.setActive(true)\n        } catch {\n            print(\"Failed to configure AVAudioSession: \\\\(error)\")\n        }\n    }\n    \n    public func startBinauralBeats(carrier: Double = 200.0, beatHz: Double = 2.5) {\n        stop()\n        self.baseCarrierFrequency = carrier\n        self.currentBeatFrequency = beatHz\n        \n        let format = AVAudioFormat(standardFormatWithSampleRate: 44100, channels: 2)!\n        self.sampleRate = format.sampleRate\n        \n        sourceNode = AVAudioSourceNode { [weak self] _, _, frameCount, audioBufferList -> OSStatus in\n            guard let self = self else { return noErr }\n            let ablPointer = UnsafeMutableAudioBufferListPointer(audioBufferList)\n            \n            let freqL = self.baseCarrierFrequency\n            let freqR = self.baseCarrierFrequency + self.currentBeatFrequency\n            let incrL = 2.0 * .pi * freqL / self.sampleRate\n            let incrR = 2.0 * .pi * freqR / self.sampleRate\n            \n            let bufferLeft = ablPointer[0].mData?.assumingMemoryBound(to: Float.self)\n            let bufferRight = ablPointer[1].mData?.assumingMemoryBound(to: Float.self)\n            \n            for frame in 0..<Int(frameCount) {\n                let sampleL = Float(sin(self.phaseLeft)) * self.masterVolume\n                let sampleR = Float(sin(self.phaseRight)) * self.masterVolume\n                \n                bufferLeft?[frame] = sampleL\n                bufferRight?[frame] = sampleR\n                \n                self.phaseLeft += incrL\n                self.phaseRight += incrR\n                \n                if self.phaseLeft > 2.0 * .pi { self.phaseLeft -= 2.0 * .pi }\n                if self.phaseRight > 2.0 * .pi { self.phaseRight -= 2.0 * .pi }\n            }\n            return noErr\n        }\n        \n        if let sourceNode = sourceNode {\n            audioEngine.attach(sourceNode)\n            audioEngine.connect(sourceNode, to: audioEngine.mainMixerNode, format: format)\n            \n            do {\n                try audioEngine.start()\n                self.isPlaying = true\n            } catch {\n                print(\"Failed to start audio engine: \\\\(error)\")\n            }\n        }\n    }\n    \n    public func stop() {\n        if audioEngine.isRunning {\n            audioEngine.stop()\n            if let sourceNode = sourceNode {\n                audioEngine.detach(sourceNode)\n                self.sourceNode = nil\n            }\n        }\n        self.isPlaying = false\n    }\n}`\n  },\n  {\n    id: \'widgetkit-lockscreen\',\n    filename: \'SomnaLuxWidget.swift\',\n    category: \'Audio & Widgets\',\n    description: \'iOS 17+ WidgetKit Lock Screen & Dynamic Island Live Activity displaying real-time Restorative Sleep Score and Wind-Down countdown.\',\n    code: `//\n//  SomnaLuxWidget.swift\n//  SomnaLux\n//  iOS 17+ WidgetKit Lock Screen & Home Screen Sleep Score Widgets\n//\n\nimport WidgetKit\nimport SwiftUI\n\npublic struct SleepScoreEntry: TimelineEntry {\n    public let date: Date\n    public let sleepScore: Int\n    public let deepPercentage: Int\n    public let hrvAverage: Int\n    public let biologicalAgeDelta: Double\n}\n\npublic struct SomnaLuxWidgetEntryView : View {\n    public var entry: SleepScoreEntry\n    @Environment(\\\\.widgetFamily) var family\n\n    public var body: some View {\n        switch family {\n        case .accessoryCircular:\n            ZStack {\n                AccessoryWidgetBackground()\n                VStack(spacing: -2) {\n                    Text(\"\\\\(entry.sleepScore)\")\n                        .font(.system(size: 20, weight: .bold, design: .rounded))\n                    Text(\"SCORE\")\n                        .font(.system(size: 8, weight: .semibold))\n                }\n            }\n        case .accessoryRectangular:\n            HStack(spacing: 8) {\n                Image(systemName: \"moon.stars.fill\")\n                    .foregroundColor(Color(red: 0.08, green: 0.72, blue: 0.65))\n                VStack(alignment: .leading) {\n                    Text(\"Sleep Score: \\\\(entry.sleepScore)\")\n                        .font(.headline)\n                    Text(\"Deep: \\\\(entry.deepPercentage)% \342\200\242 HRV: \\\\(entry.hrvAverage)ms\")\n                        .font(.caption2)\n                        .foregroundColor(.secondary)\n                }\n            }\n        case .systemSmall:\n            VStack(alignment: .leading, spacing: 8) {\n                HStack {\n                    Image(systemName: \"sparkles\")\n                        .foregroundColor(Color(red: 0.08, green: 0.72, blue: 0.65))\n                    Text(\"SomnaLux\")\n                        .font(.caption)\n                        .fontWeight(.bold)\n                }\n                Spacer()\n                Text(\"\\\\(entry.sleepScore)\")\n                    .font(.system(size: 38, weight: .bold, design: .rounded))\n                    .foregroundColor(Color(red: 0.08, green: 0.72, blue: 0.65))\n                Text(\"Restorative Index\")\n                    .font(.caption2)\n                    .foregroundColor(.secondary)\n                Text(entry.biologicalAgeDelta < 0 ? \"\\\\(String(format: \"%.1f\", entry.biologicalAgeDelta)) yrs bio-age\" : \"Optimal SWS\")\n                    .font(.system(size: 10, weight: .medium))\n                    .foregroundColor(Color(red: 0.65, green: 0.55, blue: 0.98))\n            }\n            .padding()\n            .background(Color(red: 0.06, green: 0.09, blue: 0.16))\n        default:\n            Text(\"Score: \\\\(entry.sleepScore)\")\n        }\n    }\n}\n\n@main\nstruct SomnaLuxWidgetBundle: WidgetBundle {\n    var body: some Widget {\n        SomnaLuxScoreWidget()\n    }\n}\n\nstruct SomnaLuxScoreWidget: Widget {\n    let kind: String = \"SomnaLuxScoreWidget\"\n\n    var body: some WidgetConfiguration {\n        StaticConfiguration(kind: kind, provider: SleepTimelineProvider()) { entry in\n            SomnaLuxWidgetEntryView(entry: entry)\n                .containerBackground(Color(red: 0.05, green: 0.07, blue: 0.12), for: .widget)\n        }\n        .configurationDisplayName(\"Sleep Longevity Score\")\n        .description(\"Tracks your nocturnal restorative score, HRV and biological rejuvenation.\")\n        .supportedFamilies([.accessoryCircular, .accessoryRectangular, .systemSmall, .systemMedium])\n    }\n}\n\nstruct SleepTimelineProvider: TimelineProvider {\n    func placeholder(in context: Context) -> SleepScoreEntry {\n        SleepScoreEntry(date: Date(), sleepScore: 88, deepPercentage: 22, hrvAverage: 54, biologicalAgeDelta: -2.1)\n    }\n\n    func getSnapshot(in context: Context, completion: @escaping (SleepScoreEntry) -> ()) {\n        completion(SleepScoreEntry(date: Date(), sleepScore: 88, deepPercentage: 22, hrvAverage: 54, biologicalAgeDelta: -2.1))\n    }\n\n    func getTimeline(in context: Context, completion: @escaping (Timeline<SleepScoreEntry>) -> ()) {\n        let entry = SleepScoreEntry(date: Date(), sleepScore: 86, deepPercentage: 20, hrvAverage: 52, biologicalAgeDelta: -1.8)\n        let nextUpdate = Calendar.current.date(byAdding: .hour, value: 1, to: Date())!\n        let timeline = Timeline(entries: [entry], policy: .after(nextUpdate))\n        completion(timeline)\n    }\n}`\n  }\n];\n"
