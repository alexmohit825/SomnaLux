        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        let efficiency = (averageTotalSleepTimeHours / max(1.0, averageTimeInBedHours)) * 100.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        var prescribedTIB: Double = averageTotalSleepTimeHours"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        var phase = \"Baseline Titration\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        var directive = \"\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Safety Floor: Never restrict Time in Bed below 5.0 hours to prevent micro-sleep episodes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if efficiency < 80.0 {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            phase = \"Sleep Restriction Phase\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            prescribedTIB = max(5.0, averageTotalSleepTimeHours)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            directive = \"Consolidate sleep drive by restricting bed duration to match actual sleep time (\\(String(format: \"%.1f\", prescribedTIB)) hrs). Build homeostatic adenosine pressure.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        } else if efficiency >= 85.0 && efficiency <= 90.0 {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            phase = \"Controlled Expansion (+15 min)\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            prescribedTIB = min(averageTimeInBedHours + 0.25, 9.0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            directive = \"Excellent consolidation (>85% efficiency). Expanding nightly bed window by 15 minutes.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        } else if efficiency > 90.0 {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            phase = \"Rapid Expansion (+30 min)\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            prescribedTIB = min(averageTimeInBedHours + 0.5, 9.0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            directive = \"High sleep continuity (>90% efficiency). Expanding window by 30 minutes to capture more REM sleep.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            phase = \"Maintenance & Stabilization\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            prescribedTIB = averageTimeInBedHours"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            directive = \"Maintain strict current wake-up anchor to synchronize circadian rhythm.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
