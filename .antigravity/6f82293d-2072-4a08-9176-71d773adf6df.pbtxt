        lines {
          text: "            let freqR = self.baseCarrierFrequency + self.currentBeatFrequency"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            let incrL = 2.0 * .pi * freqL / self.sampleRate"
