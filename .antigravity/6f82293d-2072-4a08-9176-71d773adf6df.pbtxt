m:space-y-0 sm:space-x-6 my-4\\\">\\n            {/* Visual Circular Gauge */}\\n            <div className=\\\"relative flex items-center justify-center w-36 h-36\\\">\\n              <svg className=\\\"w-full h-full transform -rotate-90\\\" viewBox=\\\"0 0 100 100\\\">\\n                <circle\\n                  cx=\\\"50\\\"\\n                  cy=\\\"50\\\"\\n                  r=\\\"42\\\"\\n                  className=\\\"stroke-[#1E293B]\\\"\\n                  strokeWidth=\\\"8\\\"\\n                  fill=\\\"transparent\\\"\\n                />\\n                <circle\\n                  cx=\\\"50\\\"\\n                  cy=\\\"50\\\"\\n                  r=\\\"42\\\"\\n                  className=\\\"stroke-[#2DD4BF] transition-all duration-1000 ease-out shadow-[0_0_12px_#2DD4BF]\\\"\\n                  strokeWidth=\\\"8\\\"\\n                  strokeDasharray={264}\\n                  strokeDashoffset={264 - (264 * calculatedScore) / 100}\\n                  strokeLinecap=\\\"round\\\"\\n                  fill=\\\"transparent\\\"\\n                />\\n              </svg>\\n              <div className=\\\"absolute inset-0 flex flex-col items-center justify-center text-center\\\">\\n                <span className=\\\"text-4xl font-extrabold text-white tracking-tighter\\\">\\n                  {calculatedScore}\\n                </span>\\n                <span className=\\\"text-[10px] font-semibold text-[#64748B] uppercase tracking-wider\\\">\\n                  Out of 100\\n                </span>\\n              </div>\\n            </div>\\n\\n            {/* Core Stats & Biological Age Shift */}\\n            <div className=\\\"flex-1 space-y-3 w-full\\\">\\n              <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-3.5 flex items-center justify-between\\\">\\n                <div>\\n                  <div className=\\\"text-[11px] text-[#94A3B8] font-medium\\\">Total Sleep Time</div>\\n                  <div className=\\\"text-base font-bold text-white\\\">{totalHours} hrs <span className=\\\"text-xs text-[#64748B] font-normal\\\">({record.durationMinutes}m)</span></div>\\n                </div>\\n                <div className=\\\"text-right\\\">\\n                  <div className=\\\"text-[11px] text-[#94A3B8] font-medium\\\">Sleep Efficiency</div>\\n                  <div className=\\\"text-base font-bold text-[#2DD4BF]\\\">{efficiency}%</div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-[#1E1B4B]/60 border border-[#312E81] rounded-2xl p-3.5 flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center space-x-2\\\">\\n                  <Award className=\\\"w-4 h-4 text-[#818CF8]\\\" />\\n                  <div>\\n                    <div className=\\\"text-[11px] text-[#C7D2FE] font-semibold\\\">Biological Longevity Shift</div>\\n                    <div className=\\\"text-xs text-[#94A3B8]\\\">\\n                      {deepPct >= 20 ? \'Rejuvenating at -2.4 yrs rate\' : \'Cellular strain (+1.2 yrs bio-age)\'}\\n                    </div>\\n                  </div>\\n                </div>\\n                <button \\n                  onClick={onNavigateToLongevity}\\n                  className=\\\"p-1.5 rounded-lg bg-[#6366F1]/20 hover:bg-[#6366F1]/40 text-[#C7D2FE] transition\\\"\\n                  title=\\\"View Full Longevity Prognosis\\\"\\n                >\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-[#1E293B] flex items-center justify-between text-xs text-[#94A3B8]\\\">\\n            <span className=\\\"flex items-center space-x-1.5\\\">\\n              <Clock className=\\\"w-3.5 h-3.5 text-[#64748B]\\\" />\\n              <span>Bed: <strong className=\\\"text-[#F9FAFB]\\\">{record.bedTime}</strong> \342\206\222 Wake: <strong className=\\\"text-[#F9FAFB]\\\">{record.wakeTime}</strong></span>\\n            </span>\\n            <span className=\\\"text-[#818CF8] font-semibold\\\">\\n              Latency: {record.latencyMinutes}m\\n            </span>\\n          </div>\\n\\n        </div>\\n\\n        {/* Visual Metaphor: Deep Sleep & Cellular Recovery Reservoir */}\\n        <div className=\\\"lg:col-span-7 bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between mb-3\\\">\\n              <div className=\\\"flex items-center space-x-2\\\">\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-[#2DD4BF] shadow-[0_0_8px_#2DD4BF]\\\" />\\n                <h3 className=\\\"text-lg font-bold text-white\\\">\\n                  Slow-Wave Deep Sleep (SWS) Reservoir\\n                </h3>\\n              </div>\\n              <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-[#1E293B] text-[#94A3B8] border border-[#334155]\\\">\\n                Target: 90+ min (20%)\\n              </span>\\n            </div>\\n\\n            <p className=\\\"text-xs text-[#94A3B8] leading-relaxed mb-4\\\">\\n              Slow-Wave Sleep is your somatic recovery reservoir. During this phase, 95% of daily human growth hormone (HGH) is secreted, glymphatic brain detox occurs, and cellular protein synthesis peaks.\\n            </p>\\n\\n            {/* Interactive Fluid Reservoir Bar */}\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"flex justify-between items-end text-xs\\\">\\n                <span className=\\\"font-semibold text-[#94A3B8]\\\">\\n                  Current SWS Volume: <strong className=\\\"text-[#2DD4BF] text-sm\\\">{record.deepMinutes} min</strong> ({deepPct}%)\\n                </span>\\n                <span className={`font-semibold ${deepPct >= 20 ? \'text-[#2DD4BF]\' : \'text-amber-400\'}`}>\\n                  {deepPct >= 20 ? \'\342\234\223 SWS Reservoir Full\' : `\342\232\240\357\270\217 Deficit of ${Math.max(0, 90 - record.deepMinutes)} min`}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"w-full h-8 bg-[#050505] border border-[#1E293B] rounded-2xl p-1 relative overflow-hidden flex items-center\\\">\\n                <div \\n                  className=\\\"h-full rounded-xl bg-gradient-to-r from-[#2DD4BF] via-[#818CF8] to-[#6366F1] transition-all duration-1000 relative\\\"\\n                  style={{ width: `${Math.min(100, (record.deepMinutes / 120) * 100)}%` }}\\n                >\\n                  <div className=\\\"absolute inset-0 bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.2)_50%,transparent_100%)] animate-pulse\\\" />\\n                </div>\\n                {/* 20% / 90min threshold marker */}\\n                <div className=\\\"absolute left-[75%] top-0 bottom-0 w-0.5 bg-white/40 border-dashed\\\" title=\\\"Target Line (90 min)\\\" />\\n              </div>\\n            </div>\\n\\n            {/* Stage Proportional Bar */}\\n            <div className=\\\"mt-5 space-y-1.5\\\">\\n              <div className=\\\"flex justify-between text-[11px] text-[#64748B]\\\">\\n                <span>Architecture Breakdown</span>\\n                <span>{record.durationMinutes}m Total</span>\\n              </div>\\n              <div className=\\\"w-full h-3.5 bg-[#050505] rounded-full flex overflow-hidden p-0.5 border border-[#1E293B]\\\">\\n                <div style={{ width: `${deepPct}%` }} className=\\\"bg-[#2DD4BF] h-full rounded-l-full\\\" title={`Deep: ${record.deepMinutes}m (${deepPct}%)`} />\\n                <div style={{ width: `${remPct}%` }} className=\\\"bg-[#C084FC] h-full\\\" title={`REM: ${record.remMinutes}m (${remPct}%)`} />\\n                <div style={{ width: `${lightPct}%` }} className=\\\"bg-[#6366F1] h-full\\\" title={`Light: ${record.lightMinutes}m (${lightPct}%)`} />\\n                <div style={{ width: `${awakePct}%` }} className=\\\"bg-[#F59E0B] h-full rounded-r-full\\\" title={`Awake: ${record.awakeMinutes}m (${awakePct}%)`} />\\n              </div>\\n              <div className=\\\"grid grid-cols-4 gap-2 pt-2 text-center text-xs\\\">\\n                <div className=\\\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\\\">\\n                  <div className=\\\"text-[10px] text-[#2DD4BF] font-bold uppercase tracking-wider\\\">Deep (SWS)</div>\\n                  <div className=\\\"font-bold text-white mt-0.5\\\">{record.deepMinutes}m <span className=\\\"text-[10px] text-[#64748B] font-normal\\\">({deepPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\\\">\\n                  <div className=\\\"text-[10px] text-[#C084FC] font-bold uppercase tracking-wider\\\">REM Dream</div>\\n                  <div className=\\\"font-bold text-white mt-0.5\\\">{record.remMinutes}m <span className=\\\"text-[10px] text-[#64748B] font-normal\\\">({remPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\\\">\\n                  <div className=\\\"text-[10px] text-[#818CF8] font-bold uppercase tracking-wider\\\">Light Sleep</div>\\n                  <div className=\\\"font-bold text-white mt-0.5\\\">{record.lightMinutes}m <span className=\\\"text-[10px] text-[#64748B] font-normal\\\">({lightPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\\\">\\n                  <div className=\\\"text-[10px] text-amber-400 font-bold uppercase tracking-wider\\\">WASO (Awake)</div>\\n                  <div className=\\\"font-bold text-white mt-0.5\\\">{record.awakeMinutes}m <span className=\\\"text-[10px] text-[#64748B] font-normal\\\">({record.awakeningsCount}x)</span></div>\\n                </div>\\n              </div>\\n            </div>\\n\\n          </div>\\n\\n          <div className=\\\"mt-4 pt-3 border-t border-[#1E293B] flex items-center justify-between\\\">\\n            <span className=\\\"text-xs text-[#64748B]\\\">\\n              Active Lifestyle Tags: {record.tags.slice(0, 2).join(\' \342\200\242 \')}\\n            </span>\\n            <button\\n              onClick={handleRunDiagnostic}\\n              disabled={isDiagnosing}\\n              className=\\\"px-5 py-2.5 rounded-full bg-gradient-to-r from-[#6366F1] to-[#2DD4BF] hover:opacity-90 text-white text-xs font-bold tracking-wide transition shadow-[0_0_15px_rgba(45,212,191,0.3)] flex items-center space-x-2\\\"\\n            >\\n              <Sparkles className={`w-3.5 h-3.5 ${isDiagnosing ? \'animate-spin\' : \'\'}`} />\\n              <span>{isDiagnosing ? \'Analyzing Telemetry...\' : \'Run AI Diagnostic\'}</span>\\n            </button>\\n          </div>\\n\\n        </div>\\n\\n      </div>\\n\\n      {/* AI Clinical Sleep Diagnostic Report (If Generated or Expanded) */}\\n      {(diagnosis || isDiagnosing) && (\\n        <div className=\\\"bg-[#0F172A] border border-[#2DD4BF44] rounded-[32px] p-7 shadow-[0_0_30px_rgba(45,212,191,0.15)] animate-fadeIn\\\">\\n          \\n          <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#1E293B] gap-3\\\">\\n            <div className=\\\"flex items-center space-x-3\\\">\\n              <div className=\\\"w-10 h-10 rounded-2xl bg-[#2DD4BF15] border border-[#2DD4BF44] flex items-center justify-center\\\">\\n                <Sparkles className=\\\"w-5 h-5 text-[#2DD4BF]\\\" />\\n              </div>\\n              <div>\\n                <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-[#2DD4BF]\\\">\\n                  Gemini 3.7 AI Diagnostic Engine\\n                </span>\\n                <h3 className=\\\"text-xl font-bold text-white\\\">\\n                  {diagnosis?.title || \'Synthesizing Polysomnographic Diagnostics...\'}\\n                </h3>\\n              </div>\\n            </div>\\n\\n            {diagnosis && (\\n              <div className=\\\"flex items-center space-x-3\\\">\\n                <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-[#2DD4BF15] text-[#2DD4BF] border border-[#2DD4BF44]\\\">\\n                  Severity: {diagnosis.severity}\\n                </span>\\n                <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-[#1E1B4B] text-[#C7D2FE] border border-[#312E81]\\\">\\n                  Bio-Age Shift: {diagnosis.biologicalAgeShiftYears > 0 ? `+${diagnosis.biologicalAgeShiftYears} yrs` : `${diagnosis.biologicalAgeShiftYears} yrs`}\\n                </span>\\n              </div>\\n            )}\\n          </div>\\n\\n          {isDiagnosing ? (\\n            <div className=\\\"py-12 flex flex-col items-center justify-center text-center space-y-4\\\">\\n              <div className=\\\"w-12 h-12 rounded-full border-4 border-[#2DD4BF22] border-t-[#2DD4BF] animate-spin\\\" />\\n              <p className=\\\"text-sm font-medium text-[#94A3B8]\\\">\\n                Correlating Nocturnal HRV dip against SWS sleep spindles and sleep latency...\\n              </p>\\n            </div>\\n          ) : diagnosis ? (\\n            <div className=\\\"mt-5 space-y-6\\\">\\n              \\n              {/* Summary */}\\n              <div className=\\\"p-4 rounded-2xl bg-[#050505] border border-[#1E293B]\\\">\\n                <p className=\\\"text-sm text-[#CBD5E1] leading-relaxed\\\">\\n                  {diagnosis.summary}\\n                </p>\\n              </div>\\n\\n              {/* Identified Root Causes */}\\n              <div>\\n                <h4 className=\\\"text-[10px] font-bold uppercase tracking-widest text-[#64748B] mb-3\\\">\\n                  Identified Physiological Root Causes & Biomarker Triggers\\n                </h4>\\n                <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                  {diagnosis.rootCauses.map((cause, idx) => (\\n                    <div key={idx} className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 space-y-2\\\">\\n                      <div className=\\\"flex items-center justify-between\\\">\\n                        <span className=\\\"text-xs font-bold text-[#2DD4BF]\\\">{cause.factor}</span>\\n                        <span className=\\\"text-[10px] font-semibold px-2 py-0.5 bg-[#1E293B] text-[#94A3B8] rounded\\\">\\n                          {cause.confidence}% Match\\n                        </span>\\n                      </div>\\n                      <p className=\\\"text-xs text-[#94A3B8] leading-relaxed\\\">\\n                        {cause.detail}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Immediate 3-Step Scientific Interventions */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between mb-3\\\">\\n                  <h4 className=\\\"text-[10px] font-bold uppercase tracking-widest text-[#64748B]\\\">\\n                    Immediate Proactive Interventions (Prescribed for Tonight)\\n                  </h4>\\n                  <button \\n                    onClick={onNavigateToInterventions}\\n                    className=\\\"text-xs font-bold text-[#2DD4BF] hover:text-[#5EEAD4] flex items-center space-x-1\\\"\\n                  >\\n                    <span>Open CBT-I Clinic</span>\\n                    <ArrowUpRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n                \\n                <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                  {diagnosis.immediateInterventions.map((step) => (\\n                    <div key={step.step} className=\\\"bg-[#050505] border border-[#312E81] rounded-2xl p-4 space-y-2\\\">\\n                      <div className=\\\"flex items-center space-x-2\\\">\\n                        <span className=\\\"w-6 h-6 rounded-full bg-[#2DD4BF15] border border-[#2DD4BF44] text-[#2DD4BF] flex items-center justify-center text-xs font-bold\\\">\\n                          {step.step}\\n                        </span>\\n                        <span className=\\\"text-xs font-bold text-white\\\">{step.action}</span>\\n                      </div>\\n                      <p className=\\\"text-xs text-[#94A3B8] leading-relaxed\\\">\\n                        {step.detail}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n\\n            </div>\\n          ) : null}\\n\\n        </div>\\n      )}\\n\\n      {/* Interactive Sleep Stage Hypnogram Chart */}\\n      <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 shadow-2xl space-y-4\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\\\">\\n          <div>\\n            <div className=\\\"flex items-center space-x-2\\\">\\n              <Layers className=\\\"w-4 h-4 text-[#2DD4BF]\\\" />\\n              <h3 className=\\\"text-lg font-bold text-white\\\">\\n                Interactive Sleep Architecture Hypnogram\\n              </h3>\\n            </div>\\n            <p className=\\\"text-xs text-[#94A3B8]\\\">\\n              Stepped 30-second epoch progression through Awake, REM, Light, and Slow-Wave Deep stages\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center space-x-4 text-xs font-medium\\\">\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-amber-400\\\" /><span>Awake</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-[#C084FC]\\\" /><span>REM</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-[#6366F1]\\\" /><span>Light</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-[#2DD4BF]\\\" /><span>Deep SWS</span></span>\\n          </div>\\n        </div>\\n\\n        {/* Hypnogram SVG Timeline Graph */}\\n        <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 relative overflow-hidden\\\">\\n          \\n          <div className=\\\"flex\\\">\\n            {/* Stage labels */}\\n            <div className=\\\"w-16 flex flex-col justify-between py-2 text-[11px] font-mono font-semibold text-right pr-3 border-r border-[#1E293B] select-none\\\">\\n              <span className=\\\"text-amber-400\\\">Awake</span>\\n              <span className=\\\"text-[#C084FC]\\\">REM</span>\\n              <span className=\\\"text-[#818CF8]\\\">Light</span>\\n              <span className=\\\"text-[#2DD4BF]\\\">Deep</span>\\n            </div>\\n\\n            {/* Stepped Hypnogram Canvas / SVG Blocks */}\\n            <div className=\\\"flex-1 pl-3 relative h-40 flex items-stretch\\\">\\n              <div className=\\\"w-full h-full flex items-stretch space-x-1\\\">\\n                {record.stageEpochs.map((epoch, idx) => {\\n                  const stageHeightMap = {\\n                    awake: \'h-[25%] self-start bg-amber-400/90 shadow-[0_0_10px_rgba(251,191,36,0.3)]\',\\n                    rem: \'h-[50%] self-start bg-[#C084FC]/90 shadow-[0_0_10px_rgba(192,132,252,0.3)]\',\\n                    light: \'h-[75%] self-start bg-[#6366F1]/90 shadow-[0_0_10px_rgba(99,102,241,0.3)]\',\\n                    deep: \'h-[100%] self-start bg-[#2DD4BF]/90 shadow-[0_0_10px_rgba(45,212,191,0.4)]\'\\n                  };\\n\\n                  const isHovered = selectedEpochIndex === idx;\\n\\n                  return (\\n                    <div\\n                      key={idx}\\n                      onMouseEnter={() => setSelectedEpochIndex(idx)}\\n                      onMouseLeave={() => setSelectedEpochIndex(null)}\\n                      className={`flex-1 rounded-t cursor-pointer transition-all duration-150 ${stageHeightMap[epoch.stage]} ${\\n                        isHovered ? \'scale-y-105 brightness-125\' : \'opacity-85 hover:opacity-100\'\\n                      }`}\\n                    />\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Horizontal Grid lines */}\\n              <div className=\\\"absolute inset-0 pointer-events-none flex flex-col justify-between\\\">\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Time scale */}\\n          <div className=\\\"flex justify-between text-[10px] font-mono text-[#64748B] pl-16 pt-2\\\">\\n            <span>{record.bedTime}</span>\\n            <span>01:00 AM</span>\\n            <span>03:00 AM</span>\\n            <span>05:00 AM</span>\\n            <span>{record.wakeTime}</span>\\n          </div>\\n\\n          {/* Hovered Epoch Telemetry Inspector */}\\n          {selectedEpochIndex !== null && record.stageEpochs[selectedEpochIndex] && (\\n            <div className=\\\"mt-3 p-3 bg-[#0F172A] border border-[#2DD4BF44] rounded-xl flex items-center justify-between text-xs animate-fadeIn\\\">\\n              <div className=\\\"flex items-center space-x-3\\\">\\n                <span className=\\\"font-mono text-[#2DD4BF] font-bold\\\">\\n                  Epoch {record.stageEpochs[selectedEpochIndex].timestamp}\\n                </span>\\n                <span className=\\\"uppercase text-[10px] font-bold px-2 py-0.5 rounded bg-[#1E293B] text-white\\\">\\n                  Stage: {record.stageEpochs[selectedEpochIndex].stage}\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center space-x-4 text-[#94A3B8]\\\">\\n                <span>Heart Rate: <strong className=\\\"text-white\\\">{record.stageEpochs[selectedEpochIndex].heartRate} bpm</strong></span>\\n                <span>HRV: <strong className=\\\"text-[#2DD4BF]\\\">{record.stageEpochs[selectedEpochIndex].hrv} ms</strong></span>\\n                <span>Duration: <strong className=\\\"text-white\\\">{record.stageEpochs[selectedEpochIndex].durationMinutes} min</strong></span>\\n              </div>\\n            </div>\\n          )}\\n\\n        </div>\\n\\n      </div>\\n\\n      {/* Physiological Biomarkers & Nocturnal Recovery Grid */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        \\n        {/* Nocturnal HRV */}\\n        <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-[#94A3B8]\\\">Heart Rate Variability (HRV)</span>\\n            <Activity className=\\\"w-4 h-4 text-[#2DD4BF]\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.hrvAverage}</span>\\n            <span className=\\\"text-xs text-[#64748B]\\\">ms RMSSD</span>\\n          </div>\\n          <div className=\\\"text-xs text-[#2DD4BF] font-medium\\\">\\n            {record.hrvAverage >= record.hrvBaseline ? `+${record.hrvAverage - record.hrvBaseline}ms above 30d baseline` : `${record.hrvAverage - record.hrvBaseline}ms below baseline`}\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-[#2DD4BF] rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.hrvAverage / 80) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Resting Heart Rate Nadir */}\\n        <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-[#94A3B8]\\\">Resting HR Nadir</span>\\n            <Heart className=\\\"w-4 h-4 text-rose-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.restingHeartRate}</span>\\n            <span className=\\\"text-xs text-[#64748B]\\\">bpm</span>\\n          </div>\\n          <div className=\\\"text-xs text-[#94A3B8] font-medium\\\">\\n            Reached at 03:15 AM (Healthy Vagal Dip)\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-rose-400 rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.restingHeartRate / 80) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Respiratory Rate */}\\n        <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-[#94A3B8]\\\">Respiratory Rate</span>\\n            <Wind className=\\\"w-4 h-4 text-[#818CF8]\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.respiratoryRate}</span>\\n            <span className=\\\"text-xs text-[#64748B]\\\">br/min</span>\\n          </div>\\n          <div className=\\\"text-xs text-[#C7D2FE] font-medium\\\">\\n            Steady autonomic rhythm (0.02 br/min var)\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-[#818CF8] rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.respiratoryRate / 20) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Cumulative Sleep Debt */}\\n        <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-[#94A3B8]\\\">Cumulative Sleep Debt</span>\\n            <Zap className=\\\"w-4 h-4 text-amber-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.sleepDebtHours.toFixed(1)}</span>\\n            <span className=\\\"text-xs text-[#64748B]\\\">hours</span>\\n          </div>\\n          <div className={`text-xs font-medium ${record.sleepDebtHours > 2.0 ? \'text-amber-400\' : \'text-[#2DD4BF]\'}`}>\\n            {record.sleepDebtHours > 2.0 ? \'Elevated Adenosine Backlog\' : \'Adenosine Cleared\'}\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\\\">\\n            <div \\n              className={`h-full rounded-full ${record.sleepDebtHours > 2.0 ? \'bg-amber-400\' : \'bg-[#2DD4BF]\'}`}\\n              style={{ width: `${Math.min(100, (record.sleepDebtHours / 5) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      {/* Environmental Correlators & Bedroom Sanctuary Telemetry */}\\n      <div className=\\\"bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 shadow-2xl space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div>\\n            <h3 className=\\\"text-base font-bold text-white\\\">\\n              Nocturnal Environmental Correlators (Bedroom Sanctuary)\\n            </h3>\\n            <p className=\\\"text-xs text-[#94A3B8]\\\">\\n              External microclimate parameters correlated with slow-wave sleep depth\\n            </p>\\n          </div>\\n          <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-[#2DD4BF15] text-[#2DD4BF] border border-[#2DD4BF44]\\\">\\n            Thermal Index: 92%\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4\\\">\\n          <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\\\">\\n            <Thermometer className=\\\"w-5 h-5 text-[#2DD4BF] mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">66.8\302\260F</div>\\n            <div className=\\\"text-[11px] text-[#64748B]\\\">Optimal (65-68\302\260F)</div>\\n          </div>\\n          <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\\\">\\n            <Droplets className=\\\"w-5 h-5 text-[#818CF8] mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">48% RH</div>\\n            <div className=\\\"text-[11px] text-[#64748B]\\\">Optimal (40-60%)</div>\\n          </div>\\n          <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\\\">\\n            <Wind className=\\\"w-5 h-5 text-[#C084FC] mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">32 dBA</div>\\n            <div className=\\\"text-[11px] text-[#64748B]\\\">Acoustic Floor (&lt;35 dBA)</div>\\n          </div>\\n          <div className=\\\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\\\">\\n            <Eye className=\\\"w-5 h-5 text-amber-400 mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">0.2 Lux</div>\\n            <div className=\\\"text-[11px] text-[#64748B]\\\">Total Darkness (&lt;1 Lux)</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n    </div>\\n  );\", \"TargetContent\":\"  return (\\n    <div className=\\\"space-y-8 animate-fadeIn\\\">\\n      \\n      {/* Top Hero Banner: Restorative Sleep Score + Deep Sleep Reservoir */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        \\n        {/* Restorative Score & Biological Rejuvenation Card */}\\n        <div className=\\\"lg:col-span-5 bg-gradient-to-br from-slate-900/90 via-[#0d1424]/90 to-[#090e1a]/95 border border-slate-800 rounded-3xl p-6 sm:p-7 relative overflow-hidden shadow-2xl\\\">\\n          <div className=\\\"absolute top-0 right-0 w-64 h-64 bg-teal-500/10 rounded-full blur-3xl pointer-events-none\\\" />\\n          <div className=\\\"absolute bottom-0 left-0 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none\\\" />\\n          \\n          <div className=\\\"flex items-center justify-between mb-4\\\">\\n            <div>\\n              <span className=\\\"text-xs uppercase font-bold tracking-widest text-teal-400\\\">\\n                Polysomnographic Index\\n              </span>\\n              <h2 className=\\\"text-xl font-bold text-white tracking-tight\\\">\\n                Restorative Sleep Score\\n              </h2>\\n            </div>\\n            <span className={`px-3 py-1 text-xs font-bold rounded-full border ${\\n              calculatedScore >= 85 \\n                ? \'bg-emerald-950/80 text-emerald-300 border-emerald-700/60\'\\n                : calculatedScore >= 70\\n                ? \'bg-teal-950/80 text-teal-300 border-teal-700/60\'\\n                : \'bg-amber-950/80 text-amber-300 border-amber-700/60\'\\n            }`}>\\n              {calculatedScore >= 85 ? \'Elite Recovery\' : calculatedScore >= 70 ? \'Restorative\' : \'Sub-Optimal\'}\\n            </span>\\n          </div>\\n\\n          <div className=\\\"flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-6 my-4\\\">\\n            {/* Visual Circular Gauge */}\\n            <div className=\\\"relative flex items-center justify-center w-36 h-36\\\">\\n              <svg className=\\\"w-full h-full transform -rotate-90\\\" viewBox=\\\"0 0 100 100\\\">\\n                <circle\\n                  cx=\\\"50\\\"\\n                  cy=\\\"50\\\"\\n                  r=\\\"42\\\"\\n                  className=\\\"stroke-slate-800\\\"\\n                  strokeWidth=\\\"8\\\"\\n                  fill=\\\"transparent\\\"\\n                />\\n                <circle\\n                  cx=\\\"50\\\"\\n                  cy=\\\"50\\\"\\n                  r=\\\"42\\\"\\n                  className=\\\"stroke-teal-400 transition-all duration-1000 ease-out\\\"\\n                  strokeWidth=\\\"8\\\"\\n                  strokeDasharray={264}\\n                  strokeDashoffset={264 - (264 * calculatedScore) / 100}\\n                  strokeLinecap=\\\"round\\\"\\n                  fill=\\\"transparent\\\"\\n                />\\n              </svg>\\n              <div className=\\\"absolute inset-0 flex flex-col items-center justify-center text-center\\\">\\n                <span className=\\\"text-4xl font-extrabold text-white tracking-tighter\\\">\\n                  {calculatedScore}\\n                </span>\\n                <span className=\\\"text-[10px] font-semibold text-slate-400 uppercase tracking-wider\\\">\\n                  Out of 100\\n                </span>\\n              </div>\\n            </div>\\n\\n            {/* Core Stats & Biological Age Shift */}\\n            <div className=\\\"flex-1 space-y-3 w-full\\\">\\n              <div className=\\\"bg-slate-950/60 border border-slate-800/80 rounded-2xl p-3.5 flex items-center justify-between\\\">\\n                <div>\\n                  <div className=\\\"text-[11px] text-slate-400 font-medium\\\">Total Sleep Time</div>\\n                  <div className=\\\"text-base font-bold text-white\\\">{totalHours} hrs <span className=\\\"text-xs text-slate-400 font-normal\\\">({record.durationMinutes}m)</span></div>\\n                </div>\\n                <div className=\\\"text-right\\\">\\n                  <div className=\\\"text-[11px] text-slate-400 font-medium\\\">Sleep Efficiency</div>\\n                  <div className=\\\"text-base font-bold text-teal-300\\\">{efficiency}%</div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"bg-gradient-to-r from-teal-950/40 to-indigo-950/40 border border-teal-800/40 rounded-2xl p-3.5 flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center space-x-2\\\">\\n                  <Award className=\\\"w-4 h-4 text-teal-400\\\" />\\n                  <div>\\n                    <div className=\\\"text-[11px] text-teal-300 font-semibold\\\">Biological Longevity Shift</div>\\n                    <div className=\\\"text-xs text-slate-300\\\">\\n                      {deepPct >= 20 ? \'Rejuvenating at -2.4 yrs rate\' : \'Cellular strain (+1.2 yrs bio-age)\'}\\n                    </div>\\n                  </div>\\n                </div>\\n                <button \\n                  onClick={onNavigateToLongevity}\\n                  className=\\\"p-1.5 rounded-lg bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 transition\\\"\\n                  title=\\\"View Full Longevity Prognosis\\\"\\n                >\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-slate-800/70 flex items-center justify-between text-xs text-slate-400\\\">\\n            <span className=\\\"flex items-center space-x-1.5\\\">\\n              <Clock className=\\\"w-3.5 h-3.5 text-slate-500\\\" />\\n              <span>Bed: <strong className=\\\"text-slate-200\\\">{record.bedTime}</strong> \342\206\222 Wake: <strong className=\\\"text-slate-200\\\">{record.wakeTime}</strong></span>\\n            </span>\\n            <span className=\\\"text-indigo-400 font-semibold\\\">\\n              Latency: {record.latencyMinutes}m\\n            </span>\\n          </div>\\n\\n        </div>\\n\\n        {/* Visual Metaphor: Deep Sleep & Cellular Recovery Reservoir */}\\n        <div className=\\\"lg:col-span-7 bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between mb-3\\\">\\n              <div className=\\\"flex items-center space-x-2\\\">\\n                <div className=\\\"w-2.5 h-2.5 rounded-full bg-teal-400 shadow-[0_0_8px_#14b8a6]\\\" />\\n                <h3 className=\\\"text-lg font-bold text-white\\\">\\n                  Slow-Wave Deep Sleep (SWS) Reservoir\\n                </h3>\\n              </div>\\n              <span className=\\\"text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700\\\">\\n                Target: 90+ min (20%)\\n              </span>\\n            </div>\\n\\n            <p className=\\\"text-xs text-slate-400 leading-relaxed mb-4\\\">\\n              Slow-Wave Sleep is your somatic recovery reservoir. During this phase, 95% of daily human growth hormone (HGH) is secreted, glymphatic brain detox occurs, and cellular protein synthesis peaks.\\n            </p>\\n\\n            {/* Interactive Fluid Reservoir Bar */}\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"flex justify-between items-end text-xs\\\">\\n                <span className=\\\"font-semibold text-slate-300\\\">\\n                  Current SWS Volume: <strong className=\\\"text-teal-300 text-sm\\\">{record.deepMinutes} min</strong> ({deepPct}%)\\n                </span>\\n                <span className={`font-semibold ${deepPct >= 20 ? \'text-teal-400\' : \'text-amber-400\'}`}>\\n                  {deepPct >= 20 ? \'\342\234\223 SWS Reservoir Full\' : `\342\232\240\357\270\217 Deficit of ${Math.max(0, 90 - record.deepMinutes)} min`}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"w-full h-8 bg-slate-950 border border-slate-800 rounded-2xl p-1 relative overflow-hidden flex items-center\\\">\\n                <div \\n                  className=\\\"h-full rounded-xl bg-gradient-to-r from-teal-600 via-teal-400 to-indigo-400 transition-all duration-1000 relative\\\"\\n                  style={{ width: `${Math.min(100, (record.deepMinutes / 120) * 100)}%` }}\\n                >\\n                  <div className=\\\"absolute inset-0 bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.2)_50%,transparent_100%)] animate-pulse\\\" />\\n                </div>\\n                {/* 20% / 90min threshold marker */}\\n                <div className=\\\"absolute left-[75%] top-0 bottom-0 w-0.5 bg-white/40 border-dashed\\\" title=\\\"Target Line (90 min)\\\" />\\n              </div>\\n            </div>\\n\\n            {/* Stage Proportional Bar */}\\n            <div className=\\\"mt-5 space-y-1.5\\\">\\n              <div className=\\\"flex justify-between text-[11px] text-slate-400\\\">\\n                <span>Architecture Breakdown</span>\\n                <span>{record.durationMinutes}m Total</span>\\n              </div>\\n              <div className=\\\"w-full h-3.5 bg-slate-950 rounded-full flex overflow-hidden p-0.5 border border-slate-800\\\">\\n                <div style={{ width: `${deepPct}%` }} className=\\\"bg-teal-500 h-full rounded-l-full\\\" title={`Deep: ${record.deepMinutes}m (${deepPct}%)`} />\\n                <div style={{ width: `${remPct}%` }} className=\\\"bg-purple-400 h-full\\\" title={`REM: ${record.remMinutes}m (${remPct}%)`} />\\n                <div style={{ width: `${lightPct}%` }} className=\\\"bg-indigo-500 h-full\\\" title={`Light: ${record.lightMinutes}m (${lightPct}%)`} />\\n                <div style={{ width: `${awakePct}%` }} className=\\\"bg-amber-400 h-full rounded-r-full\\\" title={`Awake: ${record.awakeMinutes}m (${awakePct}%)`} />\\n              </div>\\n              <div className=\\\"grid grid-cols-4 gap-2 pt-2 text-center text-xs\\\">\\n                <div className=\\\"bg-slate-950/60 rounded-xl p-2 border border-slate-800\\\">\\n                  <div className=\\\"text-[10px] text-teal-400 font-bold uppercase\\\">Deep (SWS)</div>\\n                  <div className=\\\"font-bold text-white\\\">{record.deepMinutes}m <span className=\\\"text-[10px] text-slate-400 font-normal\\\">({deepPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-slate-950/60 rounded-xl p-2 border border-slate-800\\\">\\n                  <div className=\\\"text-[10px] text-purple-400 font-bold uppercase\\\">REM Dream</div>\\n                  <div className=\\\"font-bold text-white\\\">{record.remMinutes}m <span className=\\\"text-[10px] text-slate-400 font-normal\\\">({remPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-slate-950/60 rounded-xl p-2 border border-slate-800\\\">\\n                  <div className=\\\"text-[10px] text-indigo-400 font-bold uppercase\\\">Light Sleep</div>\\n                  <div className=\\\"font-bold text-white\\\">{record.lightMinutes}m <span className=\\\"text-[10px] text-slate-400 font-normal\\\">({lightPct}%)</span></div>\\n                </div>\\n                <div className=\\\"bg-slate-950/60 rounded-xl p-2 border border-slate-800\\\">\\n                  <div className=\\\"text-[10px] text-amber-400 font-bold uppercase\\\">WASO (Awake)</div>\\n                  <div className=\\\"font-bold text-white\\\">{record.awakeMinutes}m <span className=\\\"text-[10px] text-slate-400 font-normal\\\">({record.awakeningsCount}x)</span></div>\\n                </div>\\n              </div>\\n            </div>\\n\\n          </div>\\n\\n          <div className=\\\"mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between\\\">\\n            <span className=\\\"text-xs text-slate-400\\\">\\n              Active Lifestyle Tags: {record.tags.slice(0, 2).join(\' \342\200\242 \')}\\n            </span>\\n            <button\\n              onClick={handleRunDiagnostic}\\n              disabled={isDiagnosing}\\n              className=\\\"px-4 py-2 rounded-xl bg-gradient-to-r from-teal-500 to-indigo-600 hover:from-teal-400 hover:to-indigo-500 text-white text-xs font-bold tracking-wide transition shadow-[0_0_15px_rgba(20,184,166,0.3)] flex items-center space-x-1.5\\\"\\n            >\\n              <Sparkles className={`w-3.5 h-3.5 ${isDiagnosing ? \'animate-spin\' : \'\'}`} />\\n              <span>{isDiagnosing ? \'Analyzing Telemetry...\' : \'Run AI Diagnostic\'}</span>\\n            </button>\\n          </div>\\n\\n        </div>\\n\\n      </div>\\n\\n      {/* AI Clinical Sleep Diagnostic Report (If Generated or Expanded) */}\\n      {(diagnosis || isDiagnosing) && (\\n        <div className=\\\"bg-gradient-to-br from-[#0c1424] via-slate-900 to-[#0d1829] border border-teal-500/30 rounded-3xl p-6 sm:p-7 shadow-[0_0_30px_rgba(20,184,166,0.15)] animate-fadeIn\\\">\\n          \\n          <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-800 gap-3\\\">\\n            <div className=\\\"flex items-center space-x-3\\\">\\n              <div className=\\\"w-10 h-10 rounded-2xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center\\\">\\n                <Sparkles className=\\\"w-5 h-5 text-teal-300\\\" />\\n              </div>\\n              <div>\\n                <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-teal-400\\\">\\n                  Gemini 3.7 AI Diagnostic Engine\\n                </span>\\n                <h3 className=\\\"text-xl font-bold text-white\\\">\\n                  {diagnosis?.title || \'Synthesizing Polysomnographic Diagnostics...\'}\\n                </h3>\\n              </div>\\n            </div>\\n\\n            {diagnosis && (\\n              <div className=\\\"flex items-center space-x-3\\\">\\n                <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-teal-950 text-teal-300 border border-teal-800\\\">\\n                  Severity: {diagnosis.severity}\\n                </span>\\n                <span className=\\\"text-xs font-semibold px-3 py-1 rounded-full bg-indigo-950 text-indigo-300 border border-indigo-800\\\">\\n                  Bio-Age Shift: {diagnosis.biologicalAgeShiftYears > 0 ? `+${diagnosis.biologicalAgeShiftYears} yrs` : `${diagnosis.biologicalAgeShiftYears} yrs`}\\n                </span>\\n              </div>\\n            )}\\n          </div>\\n\\n          {isDiagnosing ? (\\n            <div className=\\\"py-12 flex flex-col items-center justify-center text-center space-y-4\\\">\\n              <div className=\\\"w-12 h-12 rounded-full border-4 border-teal-500/20 border-t-teal-400 animate-spin\\\" />\\n              <p className=\\\"text-sm font-medium text-slate-300\\\">\\n                Correlating Nocturnal HRV dip against SWS sleep spindles and sleep latency...\\n              </p>\\n            </div>\\n          ) : diagnosis ? (\\n            <div className=\\\"mt-5 space-y-6\\\">\\n              \\n              {/* Summary */}\\n              <div className=\\\"p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80\\\">\\n                <p className=\\\"text-sm text-slate-300 leading-relaxed\\\">\\n                  {diagnosis.summary}\\n                </p>\\n              </div>\\n\\n              {/* Identified Root Causes */}\\n              <div>\\n                <h4 className=\\\"text-xs font-bold uppercase tracking-wider text-slate-400 mb-3\\\">\\n                  Identified Physiological Root Causes & Biomarker Triggers\\n                </h4>\\n                <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                  {diagnosis.rootCauses.map((cause, idx) => (\\n                    <div key={idx} className=\\\"bg-slate-950/60 border border-slate-800 rounded-2xl p-4 space-y-2\\\">\\n                      <div className=\\\"flex items-center justify-between\\\">\\n                        <span className=\\\"text-xs font-bold text-teal-300\\\">{cause.factor}</span>\\n                        <span className=\\\"text-[10px] font-semibold px-2 py-0.5 bg-slate-800 text-slate-300 rounded\\\">\\n                          {cause.confidence}% Match\\n                        </span>\\n                      </div>\\n                      <p className=\\\"text-xs text-slate-400 leading-relaxed\\\">\\n                        {cause.detail}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Immediate 3-Step Scientific Interventions */}\\n              <div>\\n                <div className=\\\"flex items-center justify-between mb-3\\\">\\n                  <h4 className=\\\"text-xs font-bold uppercase tracking-wider text-slate-400\\\">\\n                    Immediate Proactive Interventions (Prescribed for Tonight)\\n                  </h4>\\n                  <button \\n                    onClick={onNavigateToInterventions}\\n                    className=\\\"text-xs font-bold text-teal-400 hover:text-teal-300 flex items-center space-x-1\\\"\\n                  >\\n                    <span>Open CBT-I Clinic</span>\\n                    <ArrowUpRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n                \\n                <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                  {diagnosis.immediateInterventions.map((step) => (\\n                    <div key={step.step} className=\\\"bg-gradient-to-b from-slate-900 to-slate-950 border border-indigo-900/40 rounded-2xl p-4 space-y-2\\\">\\n                      <div className=\\\"flex items-center space-x-2\\\">\\n                        <span className=\\\"w-6 h-6 rounded-full bg-teal-500/20 border border-teal-500/40 text-teal-300 flex items-center justify-center text-xs font-bold\\\">\\n                          {step.step}\\n                        </span>\\n                        <span className=\\\"text-xs font-bold text-white\\\">{step.action}</span>\\n                      </div>\\n                      <p className=\\\"text-xs text-slate-400 leading-relaxed\\\">\\n                        {step.detail}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n\\n            </div>\\n          ) : null}\\n\\n        </div>\\n      )}\\n\\n      {/* Interactive Sleep Stage Hypnogram Chart */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-2xl space-y-4\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\\\">\\n          <div>\\n            <div className=\\\"flex items-center space-x-2\\\">\\n              <Layers className=\\\"w-4 h-4 text-teal-400\\\" />\\n              <h3 className=\\\"text-lg font-bold text-white\\\">\\n                Interactive Sleep Architecture Hypnogram\\n              </h3>\\n            </div>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              Stepped 30-second epoch progression through Awake, REM, Light, and Slow-Wave Deep stages\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center space-x-4 text-xs font-medium\\\">\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-amber-400\\\" /><span>Awake</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-purple-400\\\" /><span>REM</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-indigo-500\\\" /><span>Light</span></span>\\n            <span className=\\\"flex items-center space-x-1.5\\\"><span className=\\\"w-2.5 h-2.5 rounded-full bg-teal-400\\\" /><span>Deep SWS</span></span>\\n          </div>\\n        </div>\\n\\n        {/* Hypnogram SVG Timeline Graph */}\\n        <div className=\\\"bg-slate-950/80 border border-slate-800/80 rounded-2xl p-4 relative overflow-hidden\\\">\\n          \\n          <div className=\\\"flex\\\">\\n            {/* Stage labels */}\\n            <div className=\\\"w-16 flex flex-col justify-between py-2 text-[11px] font-mono font-semibold text-right pr-3 border-r border-slate-800/80 select-none\\\">\\n              <span className=\\\"text-amber-400\\\">Awake</span>\\n              <span className=\\\"text-purple-400\\\">REM</span>\\n              <span className=\\\"text-indigo-400\\\">Light</span>\\n              <span className=\\\"text-teal-400\\\">Deep</span>\\n            </div>\\n\\n            {/* Stepped Hypnogram Canvas / SVG Blocks */}\\n            <div className=\\\"flex-1 pl-3 relative h-40 flex items-stretch\\\">\\n              <div className=\\\"w-full h-full flex items-stretch space-x-1\\\">\\n                {record.stageEpochs.map((epoch, idx) => {\\n                  const stageHeightMap = {\\n                    awake: \'h-[25%] self-start bg-amber-400/90 shadow-[0_0_10px_rgba(251,191,36,0.3)]\',\\n                    rem: \'h-[50%] self-start bg-purple-400/90 shadow-[0_0_10px_rgba(192,132,252,0.3)]\',\\n                    light: \'h-[75%] self-start bg-indigo-500/90 shadow-[0_0_10px_rgba(99,102,241,0.3)]\',\\n                    deep: \'h-[100%] self-start bg-teal-400/90 shadow-[0_0_10px_rgba(20,184,166,0.4)]\'\\n                  };\\n\\n                  const isHovered = selectedEpochIndex === idx;\\n\\n                  return (\\n                    <div\\n                      key={idx}\\n                      onMouseEnter={() => setSelectedEpochIndex(idx)}\\n                      onMouseLeave={() => setSelectedEpochIndex(null)}\\n                      className={`flex-1 rounded-t cursor-pointer transition-all duration-150 ${stageHeightMap[epoch.stage]} ${\\n                        isHovered ? \'scale-y-105 brightness-125\' : \'opacity-85 hover:opacity-100\'\\n                      }`}\\n                    />\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Horizontal Grid lines */}\\n              <div className=\\\"absolute inset-0 pointer-events-none flex flex-col justify-between\\\">\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n                <div className=\\\"w-full border-b border-white/5\\\" />\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Time scale */}\\n          <div className=\\\"flex justify-between text-[10px] font-mono text-slate-500 pl-16 pt-2\\\">\\n            <span>{record.bedTime}</span>\\n            <span>01:00 AM</span>\\n            <span>03:00 AM</span>\\n            <span>05:00 AM</span>\\n            <span>{record.wakeTime}</span>\\n          </div>\\n\\n          {/* Hovered Epoch Telemetry Inspector */}\\n          {selectedEpochIndex !== null && record.stageEpochs[selectedEpochIndex] && (\\n            <div className=\\\"mt-3 p-3 bg-slate-900 border border-teal-500/40 rounded-xl flex items-center justify-between text-xs animate-fadeIn\\\">\\n              <div className=\\\"flex items-center space-x-3\\\">\\n                <span className=\\\"font-mono text-teal-300 font-bold\\\">\\n                  Epoch {record.stageEpochs[selectedEpochIndex].timestamp}\\n                </span>\\n                <span className=\\\"uppercase text-[10px] font-bold px-2 py-0.5 rounded bg-slate-800 text-white\\\">\\n                  Stage: {record.stageEpochs[selectedEpochIndex].stage}\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center space-x-4 text-slate-300\\\">\\n                <span>Heart Rate: <strong className=\\\"text-white\\\">{record.stageEpochs[selectedEpochIndex].heartRate} bpm</strong></span>\\n                <span>HRV: <strong className=\\\"text-teal-300\\\">{record.stageEpochs[selectedEpochIndex].hrv} ms</strong></span>\\n                <span>Duration: <strong className=\\\"text-white\\\">{record.stageEpochs[selectedEpochIndex].durationMinutes} min</strong></span>\\n              </div>\\n            </div>\\n          )}\\n\\n        </div>\\n\\n      </div>\\n\\n      {/* Physiological Biomarkers & Nocturnal Recovery Grid */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        \\n        {/* Nocturnal HRV */}\\n        <div className=\\\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-slate-400\\\">Heart Rate Variability (HRV)</span>\\n            <Activity className=\\\"w-4 h-4 text-teal-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.hrvAverage}</span>\\n            <span className=\\\"text-xs text-slate-400\\\">ms RMSSD</span>\\n          </div>\\n          <div className=\\\"text-xs text-teal-400 font-medium\\\">\\n            {record.hrvAverage >= record.hrvBaseline ? `+${record.hrvAverage - record.hrvBaseline}ms above 30d baseline` : `${record.hrvAverage - record.hrvBaseline}ms below baseline`}\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-teal-400 rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.hrvAverage / 80) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Resting Heart Rate Nadir */}\\n        <div className=\\\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-slate-400\\\">Resting HR Nadir</span>\\n            <Heart className=\\\"w-4 h-4 text-rose-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.restingHeartRate}</span>\\n            <span className=\\\"text-xs text-slate-400\\\">bpm</span>\\n          </div>\\n          <div className=\\\"text-xs text-slate-300 font-medium\\\">\\n            Reached at 03:15 AM (Healthy Vagal Dip)\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-rose-400 rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.restingHeartRate / 80) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Respiratory Rate */}\\n        <div className=\\\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-slate-400\\\">Respiratory Rate</span>\\n            <Wind className=\\\"w-4 h-4 text-indigo-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.respiratoryRate}</span>\\n            <span className=\\\"text-xs text-slate-400\\\">br/min</span>\\n          </div>\\n          <div className=\\\"text-xs text-indigo-300 font-medium\\\">\\n            Steady autonomic rhythm (0.02 br/min var)\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\\\">\\n            <div \\n              className=\\\"h-full bg-indigo-400 rounded-full\\\"\\n              style={{ width: `${Math.min(100, (record.respiratoryRate / 20) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Cumulative Sleep Debt */}\\n        <div className=\\\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <span className=\\\"text-xs font-semibold text-slate-400\\\">Cumulative Sleep Debt</span>\\n            <Zap className=\\\"w-4 h-4 text-amber-400\\\" />\\n          </div>\\n          <div className=\\\"flex items-baseline space-x-2\\\">\\n            <span className=\\\"text-2xl font-bold text-white\\\">{record.sleepDebtHours.toFixed(1)}</span>\\n            <span className=\\\"text-xs text-slate-400\\\">hours</span>\\n          </div>\\n          <div className={`text-xs font-medium ${record.sleepDebtHours > 2.0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\\n            {record.sleepDebtHours > 2.0 ? \'Elevated Adenosine Backlog\' : \'Adenosine Cleared\'}\\n          </div>\\n          <div className=\\\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\\\">\\n            <div \\n              className={`h-full rounded-full ${record.sleepDebtHours > 2.0 ? \'bg-amber-400\' : \'bg-emerald-400\'}`}\\n              style={{ width: `${Math.min(100, (record.sleepDebtHours / 5) * 100)}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n      {/* Environmental Correlators & Bedroom Sanctuary Telemetry */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-2xl space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div>\\n            <h3 className=\\\"text-base font-bold text-white\\\">\\n              Nocturnal Environmental Correlators (Bedroom Sanctuary)\\n            </h3>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              External microclimate parameters correlated with slow-wave sleep depth\\n            </p>\\n          </div>\\n          <span className=\\\"text-xs font-semibold px-2.5 py-1 rounded-full bg-teal-950 text-teal-300 border border-teal-800\\\">\\n            Thermal Index: 92%\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4\\\">\\n          <div className=\\\"bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center\\\">\\n            <Thermometer className=\\\"w-5 h-5 text-teal-400 mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">66.8\302\260F</div>\\n            <div className=\\\"text-[11px] text-slate-400\\\">Optimal (65-68\302\260F)</div>\\n          </div>\\n          <div className=\\\"bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center\\\">\\n            <Droplets className=\\\"w-5 h-5 text-indigo-400 mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">48% RH</div>\\n            <div className=\\\"text-[11px] text-slate-400\\\">Optimal (40-60%)</div>\\n          </div>\\n          <div className=\\\"bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center\\\">\\n            <Wind className=\\\"w-5 h-5 text-purple-400 mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">32 dBA</div>\\n            <div className=\\\"text-[11px] text-slate-400\\\">Acoustic Floor (&lt;35 dBA)</div>\\n          </div>\\n          <div className=\\\"bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center\\\">\\n            <Eye className=\\\"w-5 h-5 text-amber-400 mx-auto mb-1.5\\\" />\\n            <div className=\\\"text-lg font-bold text-white\\\">0.2 Lux</div>\\n            <div className=\\\"text-[11px] text-slate-400\\\">Total Darkness (&lt;1 Lux)</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n    </div>\\n  );\", \"TargetFile\":\"/src/components/SleepDashboard.tsx\", \"toolAction\":\"Edit SleepDashboard.tsx\", \"toolSummary\":\"Apply Elegant Dark theme to SleepDashboard\"}"
