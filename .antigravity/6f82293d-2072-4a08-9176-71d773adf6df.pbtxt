 flex items-start space-x-2.5\\\">\\n              <span className=\\\"w-5 h-5 rounded-full bg-slate-800 text-teal-400 font-bold flex items-center justify-center text-[10px] flex-shrink-0\\\">4</span>\\n              <span>Return to bed only when drowsy. Repeat if awake again.</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* 2 AM Cognitive Worry Journal & Reframer */}\\n        <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 shadow-2xl space-y-4\\\">\\n          <div className=\\\"flex items-center space-x-3\\\">\\n            <div className=\\\"w-9 h-9 rounded-2xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400\\\">\\n              <BookOpen className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-base font-bold text-white\\\">2 AM Cognitive Restructuring</h3>\\n              <p className=\\\"text-xs text-slate-400\\\">Dump intrusive catastrophic thoughts & reframe</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"space-y-3\\\">\\n            <textarea\\n              value={worryInput}\\n              onChange={(e) => setWorryInput(e.target.value)}\\n              placeholder=\\\"e.g., If I don\'t fall asleep right now, my presentation tomorrow will be a disaster...\\\"\\n              rows={2}\\n              className=\\\"w-full bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-xs text-slate-200 focus:outline-none focus:border-teal-500 resize-none\\\"\\n            />\\n\\n            <button\\n              onClick={handleReframeThought}\\n              disabled={isReframing || !worryInput.trim()}\\n              className=\\\"w-full py-2 rounded-xl bg-teal-600/30 hover:bg-teal-600/50 text-teal-200 border border-teal-500/40 text-xs font-bold transition flex items-center justify-center space-x-2\\\"\\n            >\\n              <HeartHandshake className=\\\"w-4 h-4 text-teal-400\\\" />\\n              <span>{isReframing ? \'Reframing Thought...\' : \'Apply CBT-I Cognitive Reframe\'}</span>\\n            </button>\\n\\n            {reframedThought && (\\n              <div className=\\\"p-3.5 bg-teal-950/40 border border-teal-500/40 rounded-xl text-xs text-teal-200 leading-relaxed animate-fadeIn\\\">\\n                {reframedThought}\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n      </div>\\n\\n    </div>\\n  );\", \"TargetFile\":\"/src/components/InterventionsClinic.tsx\", \"toolAction\":\"Edit InterventionsClinic.tsx\", \"toolSummary\":\"Apply Elegant Dark theme to InterventionsClinic\"}"
