        }
        lines {
          text: "    /// Standard protocol: If Efficiency > 85%, expand TIB by 15-30m. If < 80%, restrict TIB by 15-30m (Floor = 5.0h)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    public static func computePrescription("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
