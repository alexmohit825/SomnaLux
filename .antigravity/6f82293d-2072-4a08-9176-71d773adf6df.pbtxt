\\\"pt-4 border-t border-[#1E293B] flex items-center justify-end space-x-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"px-4 py-2 rounded-xl bg-[#1E293B] hover:bg-[#334155] text-[#CBD5E1] transition cursor-pointer\\\"\\n            >\\n              Cancel\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"px-5 py-2 rounded-xl bg-[#2DD4BF] hover:bg-[#2DD4BF]/90 text-[#050505] font-bold transition shadow-[0_0_15px_rgba(45,212,191,0.25)] flex items-center space-x-1.5 cursor-pointer\\\"\\n            >\\n              <Check className=\\\"w-4 h-4\\\" />\\n              <span>Save & Recalculate</span>\\n            </button>\\n          </div>\\n\\n        </form>\\n\\n      </div>\\n    </div>\", \"TargetContent\":\"    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fadeIn\\\">\\n      <div className=\\\"bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-7 max-w-lg w-full shadow-2xl space-y-5 text-white relative\\\">\\n        \\n        <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-800\\\">\\n          <div className=\\\"flex items-center space-x-2.5\\\">\\n            <Moon className=\\\"w-5 h-5 text-teal-400\\\" />\\n            <h3 className=\\\"text-lg font-bold\\\">Log Custom Sleep Record</h3>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1 rounded-xl bg-slate-800 text-slate-400 hover:text-white transition\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"space-y-4 text-xs\\\">\\n          \\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Bedtime</label>\\n              <input\\n                type=\\\"text\\\"\\n                value={bedTime}\\n                onChange={(e) => setBedTime(e.target.value)}\\n                placeholder=\\\"11:15 PM\\\"\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Wake Time</label>\\n              <input\\n                type=\\\"text\\\"\\n                value={wakeTime}\\n                onChange={(e) => setWakeTime(e.target.value)}\\n                placeholder=\\\"06:45 AM\\\"\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-3 gap-3\\\">\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Total Sleep (hrs)</label>\\n              <input\\n                type=\\\"number\\\"\\n                step=\\\"0.1\\\"\\n                value={durationHours}\\n                onChange={(e) => setDurationHours(parseFloat(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500 font-mono\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Deep SWS (min)</label>\\n              <input\\n                type=\\\"number\\\"\\n                value={deepMinutes}\\n                onChange={(e) => setDeepMinutes(parseInt(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500 font-mono\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">REM (min)</label>\\n              <input\\n                type=\\\"number\\\"\\n                value={remMinutes}\\n                onChange={(e) => setRemMinutes(parseInt(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500 font-mono\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-3 gap-3\\\">\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Avg HRV (ms)</label>\\n              <input\\n                type=\\\"number\\\"\\n                value={hrvAverage}\\n                onChange={(e) => setHrvAverage(parseInt(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500 font-mono\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Resting HR (bpm)</label>\\n              <input\\n                type=\\\"number\\\"\\n                value={restingHr}\\n                onChange={(e) => setRestingHr(parseInt(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-teal-500 font-mono\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"text-slate-300 font-medium block mb-1\\\">Latency (min)</label>\\n              <input\\n                type=\\\"number\\\"\\n                value={latencyMinutes}\\n                onChange={(e) => setLatencyMinutes(parseInt(e.target.value))}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded