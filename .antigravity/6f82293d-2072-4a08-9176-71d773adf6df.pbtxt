  file_change {
    absolute_path_uri: "file:///src/components/SleepDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Sparkles, Activity, Heart, Zap, Clock, ShieldAlert, \n  Thermometer, Wind, Eye, Droplets, ChevronRight, CheckCircle2,\n  RefreshCw, Layers, ArrowUpRight, Award, AlertCircle, Sliders,\n  Brain, ShieldCheck, Microscope, Info\n} from \'lucide-react\';\nimport { SleepRecord, UserProfile, SleepDiagnosis } from \'../types\';\nimport { sleepArchetypes } from \'../data/mockSleepData\';\n\ninterface SleepDashboardProps {\n  record: SleepRecord;\n  userProfile: UserProfile;\n  onNavigateToInterventions: () => void;\n  onNavigateToLongevity: () => void;\n  onNavigateToScience?: () => void;\n  onSelectArchetype?: (key: string) => void;\n  selectedArchetypeKey?: string;\n}\n\nexport const SleepDashboard: React.FC<SleepDashboardProps> = ({\n  record,\n  userProfile,\n  onNavigateToInterventions,\n  onNavigateToLongevity,\n  onNavigateToScience,\n  onSelectArchetype,\n  selectedArchetypeKey = \'baseline\'\n}) => {\n  const [isDiagnosing, setIsDiagnosing] = useState(false);\n  const [selectedEpochIndex, setSelectedEpochIndex] = useState<number | null>(2); // Default to a deep epoch\n  const [activeBiomarkerTab, setActiveBiomarkerTab] = useState<\'architecture\' | \'autonomic\' | \'environment\'>(\'architecture\');\n  \n  // Interactive Live What-If Modeler\n  const [simExtraDeep, setSimExtraDeep] = useState<number>(0);\n  const [simExtraHrv, setSimExtraHrv] = useState<number>(0);\n\n  // Computations with live simulator modifiers\n  const effectiveDeep = Math.min(record.durationMinutes, Math.max(10, record.deepMinutes + simExtraDeep));\n  const effectiveHrv = Math.max(15, record.hrvAverage + simExtraHrv);\n  \n  const totalHours = (record.durationMinutes / 60).toFixed(1);\n  const deepPct = Math.round((effectiveDeep / record.durationMinutes) * 100);\n  const remPct = Math.round((record.remMinutes / record.durationMinutes) * 100);\n  const lightPct = Math.round((record.lightMinutes / record.durationMinutes) * 100);\n  const awakePct = Math.round((record.awakeMinutes / record.inBedMinutes) * 100);\n  const efficiency = Math.round(record.efficiency);\n  \n  // Restorative Score: Weighted composite of SWS, REM, Efficiency & HRV\n  const calculatedScore = Math.min(100, Math.max(35, Math.round(\n    (efficiency * 0.35) + \n    (deepPct * 1.6) + \n    (remPct * 0.5) + \n    ((effectiveHrv / (record.hrvBaseline || 50)) * 20)\n  )));\n\n  // Simulated Longevity Shift\n  const bioAgeShift = deepPct >= 20 \n    ? -(1.8 + (deepPct - 20) * 0.08 + (effectiveHrv > 50 ? 0.6 : 0)).toFixed(1)\n    : +(1.4 + (20 - deepPct) * 0.09 + (effectiveHrv < 40 ? 0.8 : 0)).toFixed(1);\n\n  // Dynamic Clinical Diagnosis\n  const diagnosisData: SleepDiagnosis = {\n    title: deepPct < 15 \n      ? \'Slow-Wave Sleep Deficit & Elevated Sympathetic Nocturnal Tone\' \n      : calculatedScore >= 85\n      ? \'Optimal SWS Delta Power & Rejuvenating Vagal Autonomic Profile\'\n      : \'Fragmented Sleep Architecture & Circadian Melatonin Lag\',\n    score: calculatedScore,\n    severity: calculatedScore >= 85 ? \'Optimal\' : calculatedScore >= 65 ? \'Mild Imbalance\' : \'Moderate Risk\',\n    summary: deepPct < 15 \n      ? `Analysis indicates a ${Math.max(0, 90 - effectiveDeep)} minute slow-wave deficit with nocturnal HRV (${effectiveHrv}ms) blunted by sympathetic tone. Glymphatic CSF clearance is operating at ~62% capacity.`\n      : `High-density slow-wave sleep (${effectiveDeep} min, ${deepPct}%) with strong vagal recovery (${effectiveHrv}ms HRV). Optimal 10-20% nocturnal blood pressure dipping detected.`,\n    rootCauses: [\n      { \n        factor: \'Sympathetic Nervous System Arousal\', \n        confidence: 88, \n        detail: \'Late cognitive demands or blue light blunted vagal nerve acetylcholine output during early NREM cycles.\' \n      },\n      { \n        factor: \'Core Body Temperature Nadir Timing\', \n        confidence: 76, \n        detail: \'Delayed temperature dissipation delayed peak slow-wave sleep spindle density by ~38 minutes.\' \n      },\n      { \n        factor: \'Adenosine Homeostatic Buildup\', \n        confidence: 84, \n        detail: \'Adenosine pressure cleared effectively during the first 3.5 hours of slow-wave sleep.\' \n      }\n    ],\n    biologicalAgeShiftYears: parseFloat(bioAgeShift),\n    immediateInterventions: [\n      { step: 1, action: \'4-7-8 Parasympathetic Vagal Reset\', detail: \'6 cycles before bed to stimulate acetylcholine release across the sinoatrial node.\' },\n      { step: 2, action: \'Bedroom Thermal Microclimate (66\302\260F)\', detail: \'Trigger peripheral vasodilation 45 mins before scheduled sleep onset.\' },\n      { step: 3, action: \'Circadian Lux Anchoring\', detail: \'10,000+ lux natural sunlight within 30 minutes of waking to anchor the SCN clock.\' }\n    ]\n  };\n\n  return (\n    <div className=\"space-y-8 animate-fadeIn\">\n      \n      {/* 1. CLINICAL SLEEP ARCHETYPE TESTER (1-Click Interactive Switcher) */}\n      <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[28px] p-5 shadow-2xl space-y-3\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"flex h-2.5 w-2.5 rounded-full bg-[#2DD4BF] animate-pulse\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider text-white\">\n              Instant Clinical Scenarios & Sleep Profiles\n            </span>\n          </div>\n          <span className=\"text-[11px] text-[#94A3B8]\">\n            Click any profile to immediately simulate real-time polysomnographic changes\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5\">\n          {Object.entries(sleepArchetypes).map(([key, arch]) => {\n            const isSelected = selectedArchetypeKey === key;\n            const archEfficiency = Math.round(arch.record.efficiency);\n            const archDeep = arch.record.deepMinutes;\n            const archHrv = arch.record.hrvAverage;\n\n            return (\n              <button\n                key={key}\n                onClick={() => onSelectArchetype && onSelectArchetype(key)}\n                className={`p-3 rounded-2xl border text-left transition-all duration-200 cursor-pointer flex flex-col justify-between space-y-1.5 ${\n                  isSelected\n                    ? \'bg-[#2DD4BF15] border-[#2DD4BF] text-white shadow-[0_0_15px_rgba(45,212,191,0.2)]\'\n                    : \'bg-[#050505] border-[#1E293B] text-[#94A3B8] hover:border-[#334155] hover:text-white\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-bold truncate\">{arch.label}</span>\n                  {isSelected && <CheckCircle2 className=\"w-3.5 h-3.5 text-[#2DD4BF] flex-shrink-0\" />}\n                </div>\n                <div className=\"flex items-center space-x-2 text-[10px] font-mono\">\n                  <span className=\"text-[#2DD4BF] font-semibold\">{archDeep}m Deep</span>\n                  <span>\342\200\242</span>\n                  <span className=\"text-[#818CF8]\">{archHrv}ms HRV</span>\n                </div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. Top Hero Banner: Restorative Sleep Score + Deep Sleep Reservoir */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* Restorative Score Card */}\n        <div className=\"lg:col-span-5 bg-gradient-to-br from-[#0F172A] via-[#1E1B4B]/60 to-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 relative overflow-hidden shadow-2xl\">\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-[#2DD4BF]/10 rounded-full blur-3xl pointer-events-none\" />\n          <div className=\"absolute bottom-0 left-0 w-48 h-48 bg-[#6366F1]/10 rounded-full blur-2xl pointer-events-none\" />\n          \n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <span className=\"text-[10px] uppercase font-bold tracking-[0.2em] text-[#2DD4BF]\">\n                Polysomnographic Index\n              </span>\n              <h2 className=\"text-xl font-bold text-[#F9FAFB] tracking-tight\">\n                Restorative Sleep Score\n              </h2>\n            </div>\n            <span className={`px-3 py-1 text-xs font-bold rounded-full border ${\n              calculatedScore >= 85 \n                ? \'bg-emerald-950/80 text-emerald-300 border-emerald-700/60\'\n                : calculatedScore >= 70\n                ? \'bg-[#2DD4BF15] text-[#2DD4BF] border-[#2DD4BF44]\'\n                : \'bg-amber-950/80 text-amber-300 border-amber-700/60\'\n            }`}>\n              {calculatedScore >= 85 ? \'Elite Recovery\' : calculatedScore >= 70 ? \'Restorative\' : \'Sub-Optimal\'}\n            </span>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-6 my-4\">\n            {/* Visual Circular Gauge */}\n            <div className=\"relative flex items-center justify-center w-36 h-36\">\n              <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n                <circle\n                  cx=\"50\"\n                  cy=\"50\"\n                  r=\"42\"\n                  className=\"stroke-[#1E293B]\"\n                  strokeWidth=\"8\"\n                  fill=\"transparent\"\n                />\n                <circle\n                  cx=\"50\"\n                  cy=\"50\"\n                  r=\"42\"\n                  className=\"stroke-[#2DD4BF] transition-all duration-1000 ease-out shadow-[0_0_12px_#2DD4BF]\"\n                  strokeWidth=\"8\"\n                  strokeDasharray={264}\n                  strokeDashoffset={264 - (264 * calculatedScore) / 100}\n                  strokeLinecap=\"round\"\n                  fill=\"transparent\"\n                />\n              </svg>\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n                <span className=\"text-4xl font-extrabold text-white tracking-tighter\">\n                  {calculatedScore}\n                </span>\n                <span className=\"text-[10px] font-semibold text-[#64748B] uppercase tracking-wider\">\n                  Out of 100\n                </span>\n              </div>\n            </div>\n\n            {/* Core Stats & Biological Age Shift */}\n            <div className=\"flex-1 space-y-3 w-full\">\n              <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-3.5 flex items-center justify-between\">\n                <div>\n                  <div className=\"text-[11px] text-[#94A3B8] font-medium\">Total Sleep Time</div>\n                  <div className=\"text-base font-bold text-white\">{totalHours} hrs <span className=\"text-xs text-[#64748B] font-normal\">({record.durationMinutes}m)</span></div>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"text-[11px] text-[#94A3B8] font-medium\">Sleep Efficiency</div>\n                  <div className=\"text-base font-bold text-[#2DD4BF]\">{efficiency}%</div>\n                </div>\n              </div>\n\n              <div className=\"bg-[#1E1B4B]/60 border border-[#312E81] rounded-2xl p-3.5 flex items-center justify-between\">\n                <div className=\"flex items-center space-x-2\">\n                  <Award className=\"w-4 h-4 text-[#818CF8]\" />\n                  <div>\n                    <div className=\"text-[11px] text-[#C7D2FE] font-semibold\">Biological Longevity Shift</div>\n                    <div className=\"text-xs text-[#94A3B8]\">\n                      {parseFloat(bioAgeShift) < 0 \n                        ? `Rejuvenating at ${bioAgeShift} yrs rate` \n                        : `Cellular strain (+${bioAgeShift} yrs bio-age)`}\n                    </div>\n                  </div>\n                </div>\n                <button \n                  onClick={onNavigateToLongevity}\n                  className=\"p-1.5 rounded-lg bg-[#6366F1]/20 hover:bg-[#6366F1]/40 text-[#C7D2FE] transition cursor-pointer\"\n                  title=\"View Full Longevity Prognosis\"\n                >\n                  <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#1E293B] flex items-center justify-between text-xs text-[#94A3B8]\">\n            <span className=\"flex items-center space-x-1.5\">\n              <Clock className=\"w-3.5 h-3.5 text-[#64748B]\" />\n              <span>Bed: <strong className=\"text-[#F9FAFB]\">{record.bedTime}</strong> \342\206\222 Wake: <strong className=\"text-[#F9FAFB]\">{record.wakeTime}</strong></span>\n            </span>\n            <span className=\"text-[#818CF8] font-semibold\">\n              Latency: {record.latencyMinutes}m\n            </span>\n          </div>\n\n        </div>\n\n        {/* Visual Metaphor: Deep Sleep & Cellular Recovery Reservoir */}\n        <div className=\"lg:col-span-7 bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden\">\n          <div>\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"flex items-center space-x-2\">\n                <div className=\"w-2.5 h-2.5 rounded-full bg-[#2DD4BF] shadow-[0_0_8px_#2DD4BF]\" />\n                <h3 className=\"text-lg font-bold text-white\">\n                  Slow-Wave Deep Sleep (SWS) Reservoir\n                </h3>\n              </div>\n              <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-[#1E293B] text-[#94A3B8] border border-[#334155]\">\n                Target: 90+ min (20%)\n              </span>\n            </div>\n\n            <p className=\"text-xs text-[#94A3B8] leading-relaxed mb-4\">\n              Slow-Wave Sleep is your somatic recovery reservoir. During this phase, 95% of daily human growth hormone (HGH) is secreted, glymphatic brain detox occurs, and cellular protein synthesis peaks.\n            </p>\n\n            {/* Interactive Fluid Reservoir Bar */}\n            <div className=\"space-y-2\">\n              <div className=\"flex justify-between items-end text-xs\">\n                <span className=\"font-semibold text-[#94A3B8]\">\n                  Current SWS Volume: <strong className=\"text-[#2DD4BF] text-sm\">{effectiveDeep} min</strong> ({deepPct}%)\n                </span>\n                <span className={`font-semibold ${deepPct >= 20 ? \'text-[#2DD4BF]\' : \'text-amber-400\'}`}>\n                  {deepPct >= 20 ? \'\342\234\223 SWS Reservoir Full (Optimal Flush)\' : `\342\232\240\357\270\217 Deficit of ${Math.max(0, 90 - effectiveDeep)} min`}\n                </span>\n              </div>\n\n              <div className=\"w-full h-8 bg-[#050505] border border-[#1E293B] rounded-2xl p-1 relative overflow-hidden flex items-center\">\n                <div \n                  className=\"h-full rounded-xl bg-gradient-to-r from-[#2DD4BF] via-[#818CF8] to-[#6366F1] transition-all duration-1000 relative\"\n                  style={{ width: `${Math.min(100, (effectiveDeep / 120) * 100)}%` }}\n                >\n                  <div className=\"absolute inset-0 bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.2)_50%,transparent_100%)] animate-pulse\" />\n                </div>\n                <div className=\"absolute left-[75%] top-0 bottom-0 w-0.5 bg-white/40 border-dashed\" title=\"Target Line (90 min)\" />\n              </div>\n            </div>\n\n            {/* Stage Proportional Bar */}\n            <div className=\"mt-5 space-y-1.5\">\n              <div className=\"flex justify-between text-[11px] text-[#64748B]\">\n                <span>Architecture Breakdown</span>\n                <span>{record.durationMinutes}m Total Sleep Time</span>\n              </div>\n              <div className=\"w-full h-3.5 bg-[#050505] rounded-full flex overflow-hidden p-0.5 border border-[#1E293B]\">\n                <div style={{ width: `${deepPct}%` }} className=\"bg-[#2DD4BF] h-full rounded-l-full transition-all duration-500\" title={`Deep: ${effectiveDeep}m (${deepPct}%)`} />\n                <div style={{ width: `${remPct}%` }} className=\"bg-[#C084FC] h-full transition-all duration-500\" title={`REM: ${record.remMinutes}m (${remPct}%)`} />\n                <div style={{ width: `${lightPct}%` }} className=\"bg-[#6366F1] h-full transition-all duration-500\" title={`Light: ${record.lightMinutes}m (${lightPct}%)`} />\n                <div style={{ width: `${awakePct}%` }} className=\"bg-[#F59E0B] h-full rounded-r-full transition-all duration-500\" title={`Awake: ${record.awakeMinutes}m (${awakePct}%)`} />\n              </div>\n              <div className=\"grid grid-cols-4 gap-2 pt-2 text-center text-xs\">\n                <div className=\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\">\n                  <div className=\"text-[10px] text-[#2DD4BF] font-bold uppercase tracking-wider\">Deep (SWS)</div>\n                  <div className=\"font-bold text-white mt-0.5\">{effectiveDeep}m <span className=\"text-[10px] text-[#64748B] font-normal\">({deepPct}%)</span></div>\n                </div>\n                <div className=\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\">\n                  <div className=\"text-[10px] text-[#C084FC] font-bold uppercase tracking-wider\">REM Dream</div>\n                  <div className=\"font-bold text-white mt-0.5\">{record.remMinutes}m <span className=\"text-[10px] text-[#64748B] font-normal\">({remPct}%)</span></div>\n                </div>\n                <div className=\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\">\n                  <div className=\"text-[10px] text-[#818CF8] font-bold uppercase tracking-wider\">Light Sleep</div>\n                  <div className=\"font-bold text-white mt-0.5\">{record.lightMinutes}m <span className=\"text-[10px] text-[#64748B] font-normal\">({lightPct}%)</span></div>\n                </div>\n                <div className=\"bg-[#050505] rounded-2xl p-2.5 border border-[#1E293B]\">\n                  <div className=\"text-[10px] text-amber-400 font-bold uppercase tracking-wider\">WASO (Awake)</div>\n                  <div className=\"font-bold text-white mt-0.5\">{record.awakeMinutes}m <span className=\"text-[10px] text-[#64748B] font-normal\">({record.awakeningsCount}x)</span></div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-[#1E293B] flex items-center justify-between\">\n            {onNavigateToScience ? (\n              <button\n                onClick={onNavigateToScience}\n                className=\"text-xs font-bold text-[#2DD4BF] hover:underline flex items-center space-x-1 cursor-pointer\"\n              >\n                <Microscope className=\"w-3.5 h-3.5\" />\n                <span>Explore SWS Science & Glymphatic Detox \342\206\222</span>\n              </button>\n            ) : (\n              <span className=\"text-xs text-[#64748B]\">Tags: {record.tags.slice(0, 2).join(\' \342\200\242 \')}</span>\n            )}\n            <button\n              onClick={onNavigateToInterventions}\n              className=\"px-5 py-2 rounded-full bg-[#6366F1] hover:bg-[#6366F1]/90 text-white text-xs font-bold tracking-wide transition shadow-[0_0_15px_rgba(99,102,241,0.3)] flex items-center space-x-1.5 cursor-pointer\"\n            >\n              <span>Tonight\'s Protocol</span>\n              <ArrowUpRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* 3. INTERACTIVE \"WHAT-IF\" SLEEP & RECOVERY LIVE MODELER */}\n      <div className=\"bg-[#0F172A] border border-[#2DD4BF44] rounded-[32px] p-6 sm:p-7 shadow-2xl space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div className=\"flex items-center space-x-2.5\">\n            <div className=\"w-9 h-9 rounded-2xl bg-[#2DD4BF15] border border-[#2DD4BF44] flex items-center justify-center text-[#2DD4BF]\">\n              <Sliders className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-white\">\n                Live \"What-If\" Biomarker Modeler\n              </h3>\n              <p className=\"text-xs text-[#94A3B8]\">\n                Adjust sleep parameters in real time to observe the mathematical impact on Restorative Score & Biological Longevity\n              </p>\n            </div>\n          </div>\n          {(simExtraDeep !== 0 || simExtraHrv !== 0) && (\n            <button\n              onClick={() => { setSimExtraDeep(0); setSimExtraHrv(0); }}\n              className=\"px-3 py-1 rounded-xl bg-[#1E293B] text-xs text-[#CBD5E1] hover:text-white cursor-pointer\"\n            >\n              Reset Modeler\n            </button>\n          )}\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-1\">\n          {/* Slider 1: SWS Deep Sleep */}\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 space-y-2\">\n            <div className=\"flex justify-between text-xs font-semibold\">\n              <span className=\"text-[#CBD5E1]\">Simulate Slow-Wave Deep Sleep</span>\n              <span className=\"text-[#2DD4BF] font-mono font-bold\">\n                {effectiveDeep} min ({simExtraDeep >= 0 ? `+${simExtraDeep}` : simExtraDeep}m)\n              </span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"-30\"\n              max=\"60\"\n              step=\"5\"\n              value={simExtraDeep}\n              onChange={(e) => setSimExtraDeep(parseInt(e.target.value))}\n              className=\"w-full h-2 bg-[#1E293B] rounded-lg appearance-none cursor-pointer accent-[#2DD4BF]\"\n            />\n            <div className=\"flex justify-between text-[10px] text-[#64748B]\">\n              <span>-30m deficit</span>\n              <span>Baseline ({record.deepMinutes}m)</span>\n              <span>+60m peak</span>\n            </div>\n          </div>\n\n          {/* Slider 2: Nocturnal HRV */}\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 space-y-2\">\n            <div className=\"flex justify-between text-xs font-semibold\">\n              <span className=\"text-[#CBD5E1]\">Simulate Nocturnal Vagal HRV</span>\n              <span className=\"text-[#818CF8] font-mono font-bold\">\n                {effectiveHrv} ms ({simExtraHrv >= 0 ? `+${simExtraHrv}` : simExtraHrv}ms)\n              </span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"-20\"\n              max=\"40\"\n              step=\"2\"\n              value={simExtraHrv}\n              onChange={(e) => setSimExtraHrv(parseInt(e.target.value))}\n              className=\"w-full h-2 bg-[#1E293B] rounded-lg appearance-none cursor-pointer accent-[#818CF8]\"\n            />\n            <div className=\"flex justify-between text-[10px] text-[#64748B]\">\n              <span>-20ms stress</span>\n              <span>Baseline ({record.hrvAverage}ms)</span>\n              <span>+40ms vagal peak</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. AI & Polysomnographic Clinical Sleep Diagnosis Report */}\n      <div className=\"bg-[#0F172A] border border-[#2DD4BF44] rounded-[32px] p-7 shadow-[0_0_30px_rgba(45,212,191,0.12)] space-y-6\">\n        \n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#1E293B] gap-3\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-2xl bg-[#2DD4BF15] border border-[#2DD4BF44] flex items-center justify-center\">\n              <Sparkles className=\"w-5 h-5 text-[#2DD4BF]\" />\n            </div>\n            <div>\n              <span className=\"text-[10px] font-bold uppercase tracking-wider text-[#2DD4BF]\">\n                Gemini 3.7 AI Diagnostic Engine\n              </span>\n              <h3 className=\"text-xl font-bold text-white\">\n                {diagnosisData.title}\n              </h3>\n            </div>\n          </div>\n\n          <div className=\"flex items-center space-x-3\">\n            <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-[#2DD4BF15] text-[#2DD4BF] border border-[#2DD4BF44]\">\n              Severity: {diagnosisData.severity}\n            </span>\n            <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-[#1E1B4B] text-[#C7D2FE] border border-[#312E81]\">\n              Bio-Age Shift: {diagnosisData.biologicalAgeShiftYears > 0 ? `+${diagnosisData.biologicalAgeShiftYears} yrs` : `${diagnosisData.biologicalAgeShiftYears} yrs`}\n            </span>\n          </div>\n        </div>\n\n        {/* Summary */}\n        <div className=\"p-4 rounded-2xl bg-[#050505] border border-[#1E293B]\">\n          <p className=\"text-sm text-[#CBD5E1] leading-relaxed\">\n            {diagnosisData.summary}\n          </p>\n        </div>\n\n        {/* Identified Root Causes */}\n        <div>\n          <h4 className=\"text-[10px] font-bold uppercase tracking-widest text-[#64748B] mb-3\">\n            Identified Physiological Root Causes & Biomarker Triggers\n          </h4>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {diagnosisData.rootCauses.map((cause, idx) => (\n              <div key={idx} className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-bold text-[#2DD4BF]\">{cause.factor}</span>\n                  <span className=\"text-[10px] font-semibold px-2 py-0.5 bg-[#1E293B] text-[#94A3B8] rounded\">\n                    {cause.confidence}% Match\n                  </span>\n                </div>\n                <p className=\"text-xs text-[#94A3B8] leading-relaxed\">\n                  {cause.detail}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Immediate 3-Step Scientific Interventions */}\n        <div>\n          <div className=\"flex items-center justify-between mb-3\">\n            <h4 className=\"text-[10px] font-bold uppercase tracking-widest text-[#64748B]\">\n              Immediate Proactive Interventions (Prescribed for Tonight)\n            </h4>\n            <button \n              onClick={onNavigateToInterventions}\n              className=\"text-xs font-bold text-[#2DD4BF] hover:text-[#5EEAD4] flex items-center space-x-1 cursor-pointer\"\n            >\n              <span>Open CBT-I Clinic</span>\n              <ArrowUpRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {diagnosisData.immediateInterventions.map((step) => (\n              <div key={step.step} className=\"bg-[#050505] border border-[#312E81] rounded-2xl p-4 space-y-2\">\n                <div className=\"flex items-center space-x-2\">\n                  <span className=\"w-6 h-6 rounded-full bg-[#2DD4BF15] border border-[#2DD4BF44] text-[#2DD4BF] flex items-center justify-center text-xs font-bold\">\n                    {step.step}\n                  </span>\n                  <span className=\"text-xs font-bold text-white\">{step.action}</span>\n                </div>\n                <p className=\"text-xs text-[#94A3B8] leading-relaxed\">\n                  {step.detail}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n\n      {/* 5. Interactive Sleep Stage Hypnogram Chart with Clickable Epoch Locking */}\n      <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 shadow-2xl space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <Layers className=\"w-4 h-4 text-[#2DD4BF]\" />\n              <h3 className=\"text-lg font-bold text-white\">\n                Interactive Sleep Architecture Hypnogram\n              </h3>\n            </div>\n            <p className=\"text-xs text-[#94A3B8]\">\n              Click any bar to lock epoch telemetry, inspect EEG spindle frequency, and review delta wave power\n            </p>\n          </div>\n\n          <div className=\"flex items-center space-x-4 text-xs font-medium\">\n            <span className=\"flex items-center space-x-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-amber-400\" /><span>Awake</span></span>\n            <span className=\"flex items-center space-x-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-[#C084FC]\" /><span>REM</span></span>\n            <span className=\"flex items-center space-x-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-[#6366F1]\" /><span>Light</span></span>\n            <span className=\"flex items-center space-x-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-[#2DD4BF]\" /><span>Deep SWS</span></span>\n          </div>\n        </div>\n\n        {/* Hypnogram SVG Timeline Graph */}\n        <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 relative overflow-hidden\">\n          \n          <div className=\"flex\">\n            {/* Stage labels */}\n            <div className=\"w-16 flex flex-col justify-between py-2 text-[11px] font-mono font-semibold text-right pr-3 border-r border-[#1E293B] select-none\">\n              <span className=\"text-amber-400\">Awake</span>\n              <span className=\"text-[#C084FC]\">REM</span>\n              <span className=\"text-[#818CF8]\">Light</span>\n              <span className=\"text-[#2DD4BF]\">Deep</span>\n            </div>\n\n            {/* Stepped Hypnogram Canvas / SVG Blocks */}\n            <div className=\"flex-1 pl-3 relative h-40 flex items-stretch\">\n              <div className=\"w-full h-full flex items-stretch space-x-1\">\n                {record.stageEpochs.map((epoch, idx) => {\n                  const stageHeightMap = {\n                    awake: \'h-[25%] self-start bg-amber-400/90 shadow-[0_0_10px_rgba(251,191,36,0.3)]\',\n                    rem: \'h-[50%] self-start bg-[#C084FC]/90 shadow-[0_0_10px_rgba(192,132,252,0.3)]\',\n                    light: \'h-[75%] self-start bg-[#6366F1]/90 shadow-[0_0_10px_rgba(99,102,241,0.3)]\',\n                    deep: \'h-[100%] self-start bg-[#2DD4BF]/90 shadow-[0_0_10px_rgba(45,212,191,0.4)]\'\n                  };\n\n                  const isSelected = selectedEpochIndex === idx;\n\n                  return (\n                    <button\n                      key={idx}\n                      onClick={() => setSelectedEpochIndex(idx)}\n                      className={`flex-1 rounded-t cursor-pointer transition-all duration-150 ${stageHeightMap[epoch.stage]} ${\n                        isSelected ? \'scale-y-105 brightness-150 ring-2 ring-white\' : \'opacity-85 hover:opacity-100\'\n                      }`}\n                    />\n                  );\n                })}\n              </div>\n\n              {/* Horizontal Grid lines */}\n              <div className=\"absolute inset-0 pointer-events-none flex flex-col justify-between\">\n                <div className=\"w-full border-b border-white/5\" />\n                <div className=\"w-full border-b border-white/5\" />\n                <div className=\"w-full border-b border-white/5\" />\n                <div className=\"w-full border-b border-white/5\" />\n              </div>\n            </div>\n          </div>\n\n          {/* Time scale */}\n          <div className=\"flex justify-between text-[10px] font-mono text-[#64748B] pl-16 pt-2\">\n            <span>{record.bedTime}</span>\n            <span>01:00 AM</span>\n            <span>03:00 AM</span>\n            <span>05:00 AM</span>\n            <span>{record.wakeTime}</span>\n          </div>\n\n          {/* Hovered/Selected Epoch Telemetry Inspector */}\n          {selectedEpochIndex !== null && record.stageEpochs[selectedEpochIndex] && (\n            <div className=\"mt-4 p-4 bg-[#0F172A] border border-[#2DD4BF44] rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs animate-fadeIn\">\n              <div className=\"flex items-center space-x-3\">\n                <span className=\"font-mono text-[#2DD4BF] font-bold text-sm\">\n                  Epoch {record.stageEpochs[selectedEpochIndex].timestamp}\n                </span>\n                <span className=\"uppercase text-[10px] font-bold px-2.5 py-0.5 rounded bg-[#1E293B] text-white\">\n                  Stage: {record.stageEpochs[selectedEpochIndex].stage}\n                </span>\n                <span className=\"text-[#94A3B8]\">\n                  EEG Band: <strong className=\"text-white font-mono\">\n                    {record.stageEpochs[selectedEpochIndex].stage === \'deep\' ? \'0.5-4 Hz Delta Waves (Synchronous)\' :\n                     record.stageEpochs[selectedEpochIndex].stage === \'rem\' ? \'4-8 Hz Theta (Desynchronized)\' :\n                     record.stageEpochs[selectedEpochIndex].stage === \'light\' ? \'12-14 Hz Sleep Spindles\' : \'15-30 Hz Beta (Arousal)\'}\n                  </strong>\n                </span>\n              </div>\n              <div className=\"flex items-center space-x-4 text-[#94A3B8]\">\n                <span>Heart Rate: <strong className=\"text-white\">{record.stageEpochs[selectedEpochIndex].heartRate} bpm</strong></span>\n                <span>HRV: <strong className=\"text-[#2DD4BF]\">{record.stageEpochs[selectedEpochIndex].hrv} ms</strong></span>\n                <span>Duration: <strong className=\"text-white\">{record.stageEpochs[selectedEpochIndex].durationMinutes} min</strong></span>\n              </div>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n\n      {/* 6. Physiological Biomarkers Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        \n        {/* Nocturnal HRV */}\n        <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-semibold text-[#94A3B8]\">Heart Rate Variability (HRV)</span>\n            <Activity className=\"w-4 h-4 text-[#2DD4BF]\" />\n          </div>\n          <div className=\"flex items-baseline space-x-2\">\n            <span className=\"text-2xl font-bold text-white\">{effectiveHrv}</span>\n            <span className=\"text-xs text-[#64748B]\">ms RMSSD</span>\n          </div>\n          <div className=\"text-xs text-[#2DD4BF] font-medium\">\n            {effectiveHrv >= record.hrvBaseline ? `+${effectiveHrv - record.hrvBaseline}ms above 30d baseline` : `${effectiveHrv - record.hrvBaseline}ms below baseline`}\n          </div>\n          <div className=\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\">\n            <div \n              className=\"h-full bg-[#2DD4BF] rounded-full transition-all duration-500\"\n              style={{ width: `${Math.min(100, (effectiveHrv / 80) * 100)}%` }}\n            />\n          </div>\n        </div>\n\n        {/* Resting Heart Rate Nadir */}\n        <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-semibold text-[#94A3B8]\">Resting HR Nadir</span>\n            <Heart className=\"w-4 h-4 text-rose-400\" />\n          </div>\n          <div className=\"flex items-baseline space-x-2\">\n            <span className=\"text-2xl font-bold text-white\">{record.restingHeartRate}</span>\n            <span className=\"text-xs text-[#64748B]\">bpm</span>\n          </div>\n          <div className=\"text-xs text-[#94A3B8] font-medium\">\n            Reached at 03:15 AM (Healthy Vagal Dip)\n          </div>\n          <div className=\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\">\n            <div \n              className=\"h-full bg-rose-400 rounded-full\"\n              style={{ width: `${Math.min(100, (record.restingHeartRate / 80) * 100)}%` }}\n            />\n          </div>\n        </div>\n\n        {/* Respiratory Rate */}\n        <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-semibold text-[#94A3B8]\">Respiratory Rate</span>\n            <Wind className=\"w-4 h-4 text-[#818CF8]\" />\n          </div>\n          <div className=\"flex items-baseline space-x-2\">\n            <span className=\"text-2xl font-bold text-white\">{record.respiratoryRate}</span>\n            <span className=\"text-xs text-[#64748B]\">br/min</span>\n          </div>\n          <div className=\"text-xs text-[#C7D2FE] font-medium\">\n            Steady autonomic rhythm (0.02 br/min var)\n          </div>\n          <div className=\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\">\n            <div \n              className=\"h-full bg-[#818CF8] rounded-full\"\n              style={{ width: `${Math.min(100, (record.respiratoryRate / 20) * 100)}%` }}\n            />\n          </div>\n        </div>\n\n        {/* Cumulative Sleep Debt */}\n        <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[24px] p-6 space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-semibold text-[#94A3B8]\">Cumulative Sleep Debt</span>\n            <Zap className=\"w-4 h-4 text-amber-400\" />\n          </div>\n          <div className=\"flex items-baseline space-x-2\">\n            <span className=\"text-2xl font-bold text-white\">{record.sleepDebtHours.toFixed(1)}</span>\n            <span className=\"text-xs text-[#64748B]\">hours</span>\n          </div>\n          <div className={`text-xs font-medium ${record.sleepDebtHours > 2.0 ? \'text-amber-400\' : \'text-[#2DD4BF]\'}`}>\n            {record.sleepDebtHours > 2.0 ? \'Elevated Adenosine Backlog\' : \'Adenosine Cleared\'}\n          </div>\n          <div className=\"w-full h-1.5 bg-[#1E293B] rounded-full overflow-hidden\">\n            <div \n              className={`h-full rounded-full ${record.sleepDebtHours > 2.0 ? \'bg-amber-400\' : \'bg-[#2DD4BF]\'}`}\n              style={{ width: `${Math.min(100, (record.sleepDebtHours / 5) * 100)}%` }}\n            />\n          </div>\n        </div>\n\n      </div>\n\n      {/* 7. Environmental Correlators & Bedroom Sanctuary Telemetry */}\n      <div className=\"bg-[#0F172A] border border-[#1E293B] rounded-[32px] p-7 shadow-2xl space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-base font-bold text-white\">\n              Nocturnal Environmental Correlators (Bedroom Sanctuary)\n            </h3>\n            <p className=\"text-xs text-[#94A3B8]\">\n              External microclimate parameters correlated with slow-wave sleep depth\n            </p>\n          </div>\n          <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-[#2DD4BF15] text-[#2DD4BF] border border-[#2DD4BF44]\">\n            Thermal Index: 92%\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\">\n            <Thermometer className=\"w-5 h-5 text-[#2DD4BF] mx-auto mb-1.5\" />\n            <div className=\"text-lg font-bold text-white\">66.8\302\260F</div>\n            <div className=\"text-[11px] text-[#64748B]\">Optimal (65-68\302\260F)</div>\n          </div>\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\">\n            <Droplets className=\"w-5 h-5 text-[#818CF8] mx-auto mb-1.5\" />\n            <div className=\"text-lg font-bold text-white\">48% RH</div>\n            <div className=\"text-[11px] text-[#64748B]\">Optimal (40-60%)</div>\n          </div>\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\">\n            <Wind className=\"w-5 h-5 text-[#C084FC] mx-auto mb-1.5\" />\n            <div className=\"text-lg font-bold text-white\">32 dBA</div>\n            <div className=\"text-[11px] text-[#64748B]\">Acoustic Floor (&lt;35 dBA)</div>\n          </div>\n          <div className=\"bg-[#050505] border border-[#1E293B] rounded-2xl p-4 text-center\">\n            <Eye className=\"w-5 h-5 text-amber-400 mx-auto mb-1.5\" />\n            <div className=\"text-lg font-bold text-white\">0.2 Lux</div>\n            <div className=\"text-[11px] text-[#64748B]\">Total Darkness (&lt;1 Lux)</div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
