  file_change {
    absolute_path_uri: "file:///src/components/LongevityPrognosis.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ShieldCheck, Brain, Heart, Zap, Shield, Sparkles, \n  TrendingUp, Sliders, ArrowUpRight, Award, AlertTriangle, CheckCircle2\n} from \'lucide-react\';\nimport { SleepRecord, UserProfile, HealthPrognosisData } from \'../types\';\nimport { defaultPrognosis } from \'../data/mockSleepData\';\n\ninterface LongevityPrognosisProps {\n  record: SleepRecord;\n  userProfile: UserProfile;\n}\n\nexport const LongevityPrognosis: React.FC<LongevityPrognosisProps> = ({\n  record,\n  userProfile\n}) => {\n  // Predictive Longevity Simulation Sliders\n  const [additionalDeepMinutes, setAdditionalDeepMinutes] = useState<number>(20);\n  const [targetHrvBoost, setTargetHrvBoost] = useState<number>(10);\n  const [scheduleConsistencyDays, setScheduleConsistencyDays] = useState<number>(6);\n\n  // Dynamic simulation calculations\n  const simulatedHealthspanYears = (2.2 + (additionalDeepMinutes * 0.05) + (targetHrvBoost * 0.08) + (scheduleConsistencyDays * 0.15)).toFixed(1);\n  const simulatedCardiacRiskReduction = Math.min(45, Math.round(12 + (targetHrvBoost * 1.4) + (additionalDeepMinutes * 0.4)));\n  const simulatedNeuroclearanceBoost = Math.min(65, Math.round(18 + (additionalDeepMinutes * 1.5)));\n  const simulatedInsulinSensitivity = Math.min(40, Math.round(14 + (scheduleConsistencyDays * 3.2)));\n\n  const baseBioAge = userProfile.age - 2.2;\n  const simulatedBioAge = (baseBioAge - (parseFloat(simulatedHealthspanYears) - 2.2)).toFixed(1);\n\n  return (\n    <div className=\"space-y-8 animate-fadeIn\">\n      \n      {/* Header Banner */}\n      <div className=\"bg-gradient-to-r from-indigo-950/60 via-slate-900 to-teal-950/60 border border-indigo-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden\">\n        <div className=\"absolute -top-24 -right-24 w-72 h-72 bg-teal-500/15 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"max-w-3xl space-y-3 relative\">\n          <div className=\"inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-teal-950 text-teal-300 border border-teal-800 text-xs font-bold uppercase tracking-wider\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-teal-400\" />\n            <span>Bio-Marker Longevity Correlation Engine</span>\n          </div>\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Long-Term Health Prognosis & Biological Sleep Age\n          </h2>\n          <p className=\"text-sm text-slate-300 leading-relaxed\">\n            Sleep is not merely recovery\342\200\224it is the master neuro-endocrine regulator of cellular repair. Chronic sleep architecture deviations predict cardiovascular stiffness, amyloid burden, and insulin resistance decades in advance.\n          </p>\n        </div>\n      </div>\n\n      {/* Biological Sleep Age vs Chronological Age Card */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        <div className=\"lg:col-span-6 bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-2xl flex flex-col justify-between space-y-6\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <span className=\"text-xs uppercase font-bold tracking-wider text-teal-400\">\n                Cellular Rejuvenation Metric\n              </span>\n              <span className=\"px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800\">\n                Rejuvenating (-2.2 yrs)\n              </span>\n            </div>\n\n            <div className=\"flex items-center justify-around py-4\">\n              {/* Chronological Age */}\n              <div className=\"text-center\">\n                <div className=\"text-xs text-slate-400 font-medium mb-1\">Chronological Age</div>\n                <div className=\"text-4xl font-extrabold text-slate-300 font-mono\">{userProfile.age}</div>\n                <div className=\"text-[11px] text-slate-500 mt-1\">Calendar Years</div>\n              </div>\n\n              <div className=\"text-2xl text-teal-400 font-bold\">vs</div>\n\n              {/* Biological Sleep Age */}\n              <div className=\"text-center bg-teal-950/40 border border-teal-500/40 rounded-2xl px-6 py-3 shadow-[0_0_20px_rgba(20,184,166,0.15)]\">\n                <div className=\"text-xs text-teal-300 font-bold mb-1\">Biological Sleep Age</div>\n                <div className=\"text-4xl font-extrabold text-teal-400 font-mono\">{simulatedBioAge}</div>\n                <div className=\"text-[11px] text-teal-300 mt-1\">-{simulatedHealthspanYears} yrs Younger</div>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-400 leading-relaxed mt-2 text-center\">\n              Calculated from your nocturnal HRV parasympathetic recovery, 18.2% Slow-Wave Sleep density, and &lt;20 min sleep latency.\n            </p>\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-800 grid grid-cols-3 gap-2 text-center text-xs\">\n            <div className=\"bg-slate-950/60 rounded-xl p-2.5 border border-slate-800\">\n              <div className=\"text-[10px] text-slate-400 font-semibold\">Longevity Score</div>\n              <div className=\"text-lg font-bold text-white\">88/100</div>\n            </div>\n            <div className=\"bg-slate-950/60 rounded-xl p-2.5 border border-slate-800\">\n              <div className=\"text-[10px] text-slate-400 font-semibold\">Vascular Dipping</div>\n              <div className=\"text-lg font-bold text-teal-300\">14.2%</div>\n            </div>\n            <div className=\"bg-slate-950/60 rounded-xl p-2.5 border border-slate-800\">\n              <div className=\"text-[10px] text-slate-400 font-semibold\">Healthspan Gained</div>\n              <div className=\"text-lg font-bold text-emerald-400\">+{simulatedHealthspanYears} yrs</div>\n            </div>\n          </div>\n        </div>\n\n        {/* 30-Day, 90-Day & 5-Year Trajectory Cards */}\n        <div className=\"lg:col-span-6 space-y-4\">\n          \n          {/* 30-Day Horizon */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 flex items-start space-x-4 shadow-lg\">\n            <div className=\"w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center flex-shrink-0 text-teal-300 font-bold text-xs\">\n              30D\n            </div>\n            <div className=\"flex-1 space-y-1\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"text-sm font-bold text-white\">Neurocognitive & Metabolic Window</h4>\n                <span className=\"text-[10px] text-teal-400 font-semibold\">Immediate</span>\n              </div>\n              <ul className=\"text-xs text-slate-300 space-y-1\">\n                <li>\342\200\242 <strong className=\"text-teal-300\">+16% Working Memory</strong> & sustained cognitive endurance</li>\n                <li>\342\200\242 Enhanced glymphatic clearing of daily interstitial metabolic waste</li>\n                <li>\342\200\242 22% stabilization in next-day postprandial glucose peaks</li>\n              </ul>\n            </div>\n          </div>\n\n          {/* 90-Day Horizon */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 flex items-start space-x-4 shadow-lg\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center flex-shrink-0 text-indigo-300 font-bold text-xs\">\n              90D\n            </div>\n            <div className=\"flex-1 space-y-1\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"text-sm font-bold text-white\">Cardiovascular & Immune Remodeling</h4>\n                <span className=\"text-[10px] text-indigo-400 font-semibold\">Medium-Term</span>\n              </div>\n              <ul className=\"text-xs text-slate-300 space-y-1\">\n                <li>\342\200\242 <strong className=\"text-indigo-300\">14% reduction</strong> in systemic arterial stiffness index</li>\n                <li>\342\200\242 Baseline HRV elevation from 47ms \342\206\222 61ms (+29% vagal resilience)</li>\n                <li>\342\200\242 38% upregulation in circulating natural killer (NK) cell cytotoxicity</li>\n              </ul>\n            </div>\n          </div>\n\n          {/* 5-Year Horizon */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 flex items-start space-x-4 shadow-lg\">\n            <div className=\"w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center flex-shrink-0 text-purple-300 font-bold text-xs\">\n              5YR\n            </div>\n            <div className=\"flex-1 space-y-1\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"text-sm font-bold text-white\">Longevity & Neurodegenerative Protection</h4>\n                <span className=\"text-[10px] text-purple-400 font-semibold\">Long-Term</span>\n              </div>\n              <ul className=\"text-xs text-slate-300 space-y-1\">\n                <li>\342\200\242 <strong className=\"text-purple-300\">+{simulatedHealthspanYears} Biological Healthspan Years</strong> gained</li>\n                <li>\342\200\242 48% lower lifetime hazard ratio for mild cognitive impairment & Alzheimer\342\200\231s</li>\n                <li>\342\200\242 32% lower risk of hypertension and metabolic syndrome development</li>\n              </ul>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Multi-Organ Biological Impact Models */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5\">\n        \n        {/* Brain Glymphatic Detox */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 space-y-3 shadow-xl\">\n          <div className=\"w-10 h-10 rounded-2xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400\">\n            <Brain className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"text-base font-bold text-white\">Brain Glymphatic Detox</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            During deep SWS, glial cells shrink by 60%, allowing cerebrospinal fluid (CSF) to flush out Tau and Beta-Amyloid aggregates.\n          </p>\n          <div className=\"pt-2 border-t border-slate-800 flex justify-between items-center text-xs\">\n            <span className=\"text-slate-400\">Clearance Efficacy</span>\n            <span className=\"font-bold text-teal-300\">91% Optimal</span>\n          </div>\n        </div>\n\n        {/* Cardiovascular Longevity */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 space-y-3 shadow-xl\">\n          <div className=\"w-10 h-10 rounded-2xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400\">\n            <Heart className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"text-base font-bold text-white\">Cardiovascular Dipping</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Nocturnal blood pressure dipping (10-20% below daytime) relieves endothelial sheer stress and prevents coronary microvascular remodeling.\n          </p>\n          <div className=\"pt-2 border-t border-slate-800 flex justify-between items-center text-xs\">\n            <span className=\"text-slate-400\">Arterial Elasticity</span>\n            <span className=\"font-bold text-rose-300\">High Compliance</span>\n          </div>\n        </div>\n\n        {/* Metabolic & Insulin Sensitivity */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 space-y-3 shadow-xl\">\n          <div className=\"w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400\">\n            <Zap className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"text-base font-bold text-white\">Endocrine & Insulin Sensitivity</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Single-night sleep restriction triggers 25% insulin resistance. Consolidating SWS re-sensitizes GLUT4 glucose transporters.\n          </p>\n          <div className=\"pt-2 border-t border-slate-800 flex justify-between items-center text-xs\">\n            <span className=\"text-slate-400\">HbA1c Hazard Ratio</span>\n            <span className=\"font-bold text-amber-300\">-28% Risk</span>\n          </div>\n        </div>\n\n        {/* Immune System Cytotoxicity */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-3xl p-6 space-y-3 shadow-xl\">\n          <div className=\"w-10 h-10 rounded-2xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400\">\n            <Shield className=\"w-5 h-5\" />\n          </div>\n          <h3 className=\"text-base font-bold text-white\">Immune Surveillance</h3>\n          <p className=\"text-xs text-slate-400 leading-relaxed\">\n            Natural Killer (NK) cells identify nascent neoplastic and viral cells during deep sleep cytokine signaling cascades.\n          </p>\n          <div className=\"pt-2 border-t border-slate-800 flex justify-between items-center text-xs\">\n            <span className=\"text-slate-400\">NK Cytotoxicity</span>\n            <span className=\"font-bold text-purple-300\">+34% Active</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Interactive \"What-If\" Predictive Longevity Simulator */}\n      <div className=\"bg-gradient-to-br from-slate-900 via-[#0d1627] to-slate-900 border border-teal-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-2xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400\">\n              <Sliders className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-lg font-bold text-white\">\n                Interactive Predictive Longevity Simulator\n              </h3>\n              <p className=\"text-xs text-slate-400\">\n                Adjust clinical parameters to model real-time changes in biological healthspan & disease risk\n              </p>\n            </div>\n          </div>\n          <span className=\"text-xs font-bold px-3 py-1 rounded-full bg-teal-950 text-teal-300 border border-teal-800\">\n            Real-Time Mathematical Model\n          </span>\n        </div>\n\n        {/* 3 Sliders */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-2\">\n          \n          {/* Slider 1: Deep Sleep Increase */}\n          <div className=\"space-y-2.5 bg-slate-950/70 border border-slate-800 rounded-2xl p-4\">\n            <div className=\"flex justify-between text-xs font-semibold\">\n              <span className=\"text-slate-300\">Target Deep Sleep Increase</span>\n              <span className=\"text-teal-400 font-mono\">+{additionalDeepMinutes} min/night</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"60\"\n              step=\"5\"\n              value={additionalDeepMinutes}\n              onChange={(e) => setAdditionalDeepMinutes(parseInt(e.target.value))}\n              className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-teal-400\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500\">\n              <span>0 min</span>\n              <span>+30 min</span>\n              <span>+60 min</span>\n            </div>\n          </div>\n\n          {/* Slider 2: Target HRV Boost */}\n          <div className=\"space-y-2.5 bg-slate-950/70 border border-slate-800 rounded-2xl p-4\">\n            <div className=\"flex justify-between text-xs font-semibold\">\n              <span className=\"text-slate-300\">Nocturnal HRV Elevation</span>\n              <span className=\"text-indigo-400 font-mono\">+{targetHrvBoost} ms RMSSD</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"30\"\n              step=\"2\"\n              value={targetHrvBoost}\n              onChange={(e) => setTargetHrvBoost(parseInt(e.target.value))}\n              className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-400\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500\">\n              <span>0 ms</span>\n              <span>+15 ms</span>\n              <span>+30 ms</span>\n            </div>\n          </div>\n\n          {/* Slider 3: Circadian Wake-Time Consistency */}\n          <div className=\"space-y-2.5 bg-slate-950/70 border border-slate-800 rounded-2xl p-4\">\n            <div className=\"flex justify-between text-xs font-semibold\">\n              <span className=\"text-slate-300\">Weekly Consistency Days</span>\n              <span className=\"text-purple-400 font-mono\">{scheduleConsistencyDays} / 7 days</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"1\"\n              max=\"7\"\n              step=\"1\"\n              value={scheduleConsistencyDays}\n              onChange={(e) => setScheduleConsistencyDays(parseInt(e.target.value))}\n              className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-400\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500\">\n              <span>1 day</span>\n              <span>4 days</span>\n              <span>7 days strict</span>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Dynamic Simulation Output Metrics */}\n        <div className=\"p-5 rounded-2xl bg-gradient-to-r from-teal-950/60 via-slate-950 to-indigo-950/60 border border-teal-800/40 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center\">\n          <div>\n            <div className=\"text-[11px] text-slate-400 font-medium\">Healthspan Gained</div>\n            <div className=\"text-2xl font-bold text-teal-400 font-mono\">+{simulatedHealthspanYears} yrs</div>\n            <div className=\"text-[10px] text-teal-300\">Lifetime Projection</div>\n          </div>\n          <div>\n            <div className=\"text-[11px] text-slate-400 font-medium\">Cardiac Risk Drop</div>\n            <div className=\"text-2xl font-bold text-rose-400 font-mono\">-{simulatedCardiacRiskReduction}%</div>\n            <div className=\"text-[10px] text-rose-300\">Endothelial Relief</div>\n          </div>\n          <div>\n            <div className=\"text-[11px] text-slate-400 font-medium\">Amyloid Flush Rate</div>\n            <div className=\"text-2xl font-bold text-indigo-400 font-mono\">+{simulatedNeuroclearanceBoost}%</div>\n            <div className=\"text-[10px] text-indigo-300\">CSF-ISF Exchange</div>\n          </div>\n          <div>\n            <div className=\"text-[11px] text-slate-400 font-medium\">Insulin Sensitivity</div>\n            <div className=\"text-2xl font-bold text-emerald-400 font-mono\">+{simulatedInsulinSensitivity}%</div>\n            <div className=\"text-[10px] text-emerald-300\">GLUT4 Translocation</div>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
